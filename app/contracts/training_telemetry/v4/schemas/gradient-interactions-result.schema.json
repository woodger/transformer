{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/training-telemetry/v4/gradient-interactions-result.schema.json",
  "title": "transformer.training-telemetry.v4.gradient-interactions result",
  "oneOf": [
    {"$ref": "#/$defs/notCollected"},
    {"$ref": "#/$defs/available"}
  ],
  "$defs": {
    "notCollected": {
      "type": "object", "additionalProperties": false,
      "required": ["requestId", "state", "modelRef", "epoch", "reason"],
      "properties": {
        "requestId": {"$ref": "common.schema.json#/$defs/uuid"},
        "state": {"const": "notCollected"},
        "modelRef": {"$ref": "common.schema.json#/$defs/modelRef"},
        "epoch": {"$ref": "common.schema.json#/$defs/positiveInteger"},
        "reason": {"enum": ["DIAGNOSTICS_NOT_CONFIGURED", "NO_OBSERVATIONS_FOR_EPOCH"]}
      }
    },
    "available": {
      "type": "object", "additionalProperties": false,
      "required": ["requestId", "state", "modelRef", "producingRunId", "epoch", "components", "pairPage"],
      "properties": {
        "requestId": {"$ref": "common.schema.json#/$defs/uuid"},
        "state": {"const": "available"},
        "modelRef": {"$ref": "common.schema.json#/$defs/modelRef"},
        "producingRunId": {"$ref": "common.schema.json#/$defs/uuid"},
        "epoch": {"$ref": "common.schema.json#/$defs/positiveInteger"},
        "components": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "common.schema.json#/$defs/gradientComponent"}},
        "pairPage": {"$ref": "common.schema.json#/$defs/gradientPairPage"}
      }
    }
  }
}
