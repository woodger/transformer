{
  "contract": "transformer-training-telemetry",
  "revision": 2,
  "operations": [
    "report",
    "gradientInteractions"
  ],
  "transport": {
    "actions": {
      "report": "transformer.training-telemetry.v2.report",
      "gradientInteractions": "transformer.training-telemetry.v2.gradient-interactions"
    },
    "protocol": "ArrowFlightDoAction"
  },
  "metricFamilies": [
    "epochLosses",
    "targetErrors",
    "optimizerHealth",
    "gradientInteractions"
  ],
  "availabilityStates": [
    "pending",
    "unavailable",
    "available"
  ],
  "gradientAvailabilityStates": [
    "notConfigured",
    "configuredWithoutObservations",
    "available"
  ],
  "epochObservation": {
    "checkpointReevaluation": false,
    "measurementPoint": "PreOptimizerUpdateEpochPass"
  },
  "outcomePrecedence": [
    "ModelLookup",
    "Pending",
    "Unavailable",
    "IntegrityFailure",
    "Available"
  ],
  "limits": {
    "maxEpochPageSize": 100,
    "maxGradientPairPageSize": 1000,
    "cursorTtlSeconds": 900,
    "maxResponseBytes": 8388608,
    "maxRetainedSnapshotCount": 64,
    "maxRetainedSnapshotBytes": 16777216,
    "maxRetainedSnapshotTotalBytes": 67108864
  },
  "features": {
    "ownerScope": "AuthenticatedSubject",
    "selector": "ExactModelRef",
    "batchQuery": false,
    "partialReports": false,
    "checkpointVerification": false,
    "structuredErrors": true,
    "cursorRestartOutcome": "TELEMETRY_CURSOR_INVALIDATED",
    "snapshotAdmission": "AtomicNoLiveEviction"
  }
}
