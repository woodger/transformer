{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/metrics/v2/artifact.schema.json",
  "title": "OpenSearch training metrics artifact metadata v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@timestamp", "schema", "artifactId", "documentSha256",
    "deploymentId", "kind", "owner", "runId", "transformerJobId",
    "attemptId", "attempt", "modelRef", "format", "mediaType", "bytes",
    "rowCount", "sha256", "transformerVersion", "transformerGitCommit"
  ],
  "properties": {
    "@timestamp": {"type": "string", "format": "date-time"},
    "schema": {"const": "inventory.metrics.artifact.v2"},
    "artifactId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "documentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deploymentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "kind": {"const": "training-metrics"},
    "owner": {"const": "transformer"},
    "runId": {"type": "string", "format": "uuid"},
    "transformerJobId": {"type": "string", "format": "uuid"},
    "attemptId": {"type": "string", "format": "uuid"},
    "attempt": {"type": "integer", "minimum": 1},
    "modelRef": {"type": "string", "pattern": "^mdl_[0-9a-f]{32}$"},
    "format": {"const": "transformer.training-metrics.v2"},
    "mediaType": {"const": "application/x-ndjson"},
    "bytes": {"type": "integer", "minimum": 1},
    "rowCount": {"type": "integer", "minimum": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "transformerVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "transformerGitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
