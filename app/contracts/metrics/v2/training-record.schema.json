{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/metrics/v2/training-record.schema.json",
  "title": "Transformer immutable training metrics record v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "recordedAt", "jobId", "attemptId", "attempt", "modelRef",
    "dataContractSha256", "objectiveConfigSha256", "checkpointFormat",
    "transformerVersion", "transformerGitCommit", "mode", "frame", "epoch",
    "step", "rows", "batches", "lr", "loss_stage", "minimum_loss_stage",
    "maximum_loss_stage", "loss", "loss_l0", "loss_l1", "loss_l2",
    "loss_l3", "loss_l4", "loss_l5", "loss_nll", "loss_ev",
    "mean_return_mae", "sigma_return_mae", "prob_tp_mae", "prob_sl_mae",
    "volatility_next_mae", "hitting_prob_tp_mae", "mean_return_rmse",
    "sigma_return_rmse", "prob_tp_rmse", "prob_sl_rmse",
    "volatility_next_rmse", "hitting_prob_tp_rmse", "selection_score",
    "trainingBatchesCompleted", "optimizerUpdatesApplied",
    "optimizerUpdatesSkipped", "ampOverflowBatches",
    "finiteGradientBatches", "nonFiniteGradientBatches",
    "preClipGradientNormMean", "preClipGradientNormMax",
    "preClipGradientNormP95", "nan_ratio", "masked_token_ratio", "complete_token_ratio",
    "partial_token_ratio", "empty_token_ratio", "input_pipeline_ms",
    "missing_stats_ms", "host_to_device_ms", "train_step_ms", "elapsed_ms",
    "checkpoint_best", "should_stop", "best_selection_score"
  ],
  "properties": {
    "format": {"const": "transformer.training-metrics.v2"},
    "recordedAt": {"type": "string", "format": "date-time"},
    "jobId": {"type": "string", "format": "uuid"},
    "attemptId": {"type": "string", "format": "uuid"},
    "attempt": {"type": "integer", "minimum": 1},
    "modelRef": {"type": "string", "pattern": "^mdl_[0-9a-f]{32}$"},
    "dataContractSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "objectiveConfigSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpointFormat": {"type": "string", "minLength": 1, "maxLength": 64},
    "transformerVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "transformerGitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "mode": {"const": "fit-stream"},
    "frame": {"type": ["integer", "null"], "minimum": 0},
    "epoch": {"type": "integer", "minimum": 1},
    "step": {"type": "integer", "minimum": 0},
    "rows": {"type": "integer", "minimum": 1},
    "batches": {"type": "integer", "minimum": 1},
    "lr": {"type": "number", "minimum": 0},
    "loss_stage": {"type": "integer", "minimum": 0},
    "minimum_loss_stage": {"type": "integer", "minimum": 0},
    "maximum_loss_stage": {"type": "integer", "minimum": 0},
    "loss": {"type": "number"},
    "loss_l0": {"type": "number"},
    "loss_l1": {"type": "number"},
    "loss_l2": {"type": "number"},
    "loss_l3": {"type": "number"},
    "loss_l4": {"type": "number"},
    "loss_l5": {"type": "number"},
    "loss_nll": {"type": "number"},
    "loss_ev": {"type": "number"},
    "mean_return_mae": {"type": "number", "minimum": 0},
    "sigma_return_mae": {"type": "number", "minimum": 0},
    "prob_tp_mae": {"type": "number", "minimum": 0},
    "prob_sl_mae": {"type": "number", "minimum": 0},
    "volatility_next_mae": {"type": "number", "minimum": 0},
    "hitting_prob_tp_mae": {"type": "number", "minimum": 0},
    "mean_return_rmse": {"type": "number", "minimum": 0},
    "sigma_return_rmse": {"type": "number", "minimum": 0},
    "prob_tp_rmse": {"type": "number", "minimum": 0},
    "prob_sl_rmse": {"type": "number", "minimum": 0},
    "volatility_next_rmse": {"type": "number", "minimum": 0},
    "hitting_prob_tp_rmse": {"type": "number", "minimum": 0},
    "selection_score": {"type": ["number", "null"]},
    "trainingBatchesCompleted": {"type": "integer", "minimum": 1},
    "optimizerUpdatesApplied": {"type": "integer", "minimum": 0},
    "optimizerUpdatesSkipped": {"type": "integer", "minimum": 0},
    "ampOverflowBatches": {"type": "integer", "minimum": 0},
    "finiteGradientBatches": {"type": "integer", "minimum": 0},
    "nonFiniteGradientBatches": {"type": "integer", "minimum": 0},
    "preClipGradientNormMean": {"type": ["number", "null"], "minimum": 0},
    "preClipGradientNormMax": {"type": ["number", "null"], "minimum": 0},
    "preClipGradientNormP95": {"type": ["number", "null"], "minimum": 0},
    "nan_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "masked_token_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "complete_token_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "partial_token_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "empty_token_ratio": {"type": "number", "minimum": 0, "maximum": 1},
    "input_pipeline_ms": {"type": "number", "minimum": 0},
    "missing_stats_ms": {"type": "number", "minimum": 0},
    "host_to_device_ms": {"type": "number", "minimum": 0},
    "train_step_ms": {"type": "number", "minimum": 0},
    "elapsed_ms": {"type": "number", "minimum": 0},
    "checkpoint_best": {"type": "boolean"},
    "should_stop": {"type": "boolean"},
    "best_selection_score": {"type": ["number", "null"]}
  }
}
