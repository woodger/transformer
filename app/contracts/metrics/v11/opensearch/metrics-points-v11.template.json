{
  "index_patterns": [
    "metrics-points-v11"
  ],
  "priority": 500,
  "template": {
    "settings": {
      "number_of_replicas": 0
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "schema": {
          "type": "keyword"
        },
        "eventId": {
          "type": "keyword"
        },
        "documentSha256": {
          "type": "keyword"
        },
        "recordedAt": {
          "type": "date"
        },
        "deploymentId": {
          "type": "keyword"
        },
        "runId": {
          "type": "keyword"
        },
        "attemptId": {
          "type": "keyword"
        },
        "attempt": {
          "type": "integer"
        },
        "modelRef": {
          "type": "keyword"
        },
        "semanticDigests": {
          "properties": {
            "dataContractSha256": {
              "type": "keyword"
            },
            "targetContractSha256": {
              "type": "keyword"
            },
            "objectiveSha256": {
              "type": "keyword"
            },
            "modelDefinitionSha256": {
              "type": "keyword"
            }
          }
        },
        "epoch": {
          "type": "integer"
        },
        "step": {
          "type": "long"
        },
        "target": {
          "properties": {
            "identity": {
              "type": "keyword"
            },
            "index": {
              "type": "integer"
            }
          }
        },
        "component": {
          "properties": {
            "identity": {
              "type": "keyword"
            },
            "operator": {
              "type": "keyword"
            }
          }
        },
        "pair": {
          "properties": {
            "leftComponentIdentity": {
              "type": "keyword"
            },
            "rightComponentIdentity": {
              "type": "keyword"
            }
          }
        },
        "metric": {
          "properties": {
            "name": {
              "type": "keyword"
            },
            "value": {
              "type": "double"
            },
            "unit": {
              "type": "keyword"
            }
          }
        }
      }
    }
  }
}

