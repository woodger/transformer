{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/metrics/v1/point.schema.json",
  "title": "OpenSearch training metric point v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@timestamp", "schema", "eventId", "documentSha256", "deploymentId",
    "runId", "source", "eventKind", "transformerJobId", "attemptId",
    "attempt", "modelRef", "epoch", "step", "lossStage",
    "dataContractSha256", "objectiveConfigSha256", "checkpointFormat",
    "transformerVersion", "transformerGitCommit", "metric", "attributes"
  ],
  "properties": {
    "@timestamp": {"type": "string", "format": "date-time"},
    "schema": {"const": "inventory.metrics.point.v1"},
    "eventId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "documentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deploymentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "runId": {"type": "string", "format": "uuid"},
    "source": {"const": "transformer"},
    "eventKind": {"const": "training.epoch"},
    "transformerJobId": {"type": "string", "format": "uuid"},
    "attemptId": {"type": "string", "format": "uuid"},
    "attempt": {"type": "integer", "minimum": 1},
    "modelRef": {"type": "string", "pattern": "^mdl_[0-9a-f]{32}$"},
    "frame": {"type": "integer", "minimum": 0},
    "epoch": {"type": "integer", "minimum": 1},
    "step": {"type": "integer", "minimum": 0},
    "lossStage": {"type": "integer", "minimum": 0},
    "targetIndex": {"type": "integer", "minimum": 0, "maximum": 5},
    "dataContractSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "objectiveConfigSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpointFormat": {"type": "string", "minLength": 1, "maxLength": 64},
    "transformerVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "transformerGitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit"],
      "properties": {
        "name": {
          "enum": [
            "training.loss.total",
            "training.loss.direct.mean_return",
            "training.loss.direct.sigma_return",
            "training.loss.direct.prob_tp",
            "training.loss.direct.prob_sl",
            "training.loss.direct.volatility_next",
            "training.loss.direct.hitting_prob_tp",
            "training.loss.auxiliary.nll",
            "training.loss.auxiliary.ev",
            "training.target.mean_return.mae",
            "training.target.sigma_return.mae",
            "training.target.prob_tp.mae",
            "training.target.prob_sl.mae",
            "training.target.volatility_next.mae",
            "training.target.hitting_prob_tp.mae",
            "training.target.mean_return.rmse",
            "training.target.sigma_return.rmse",
            "training.target.prob_tp.rmse",
            "training.target.prob_sl.rmse",
            "training.target.volatility_next.rmse",
            "training.target.hitting_prob_tp.rmse",
            "training.selection.score",
            "training.gradient.pre_clip_norm",
            "training.learning_rate",
            "training.input.nan_ratio",
            "training.input.masked_token_ratio",
            "training.input.complete_token_ratio",
            "training.input.partial_token_ratio",
            "training.input.empty_token_ratio",
            "training.phase.input_pipeline",
            "training.phase.missing_stats",
            "training.phase.host_to_device",
            "training.phase.train_step",
            "training.phase.epoch_elapsed"
          ]
        },
        "value": {"type": "number"},
        "unit": {"enum": ["1", "ratio", "ms"]}
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpointBest", "shouldStop", "bestSelectionScore"],
      "properties": {
        "checkpointBest": {"type": "boolean"},
        "shouldStop": {"type": "boolean"},
        "bestSelectionScore": {"type": ["number", "null"]}
      }
    }
  }
}
