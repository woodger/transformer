{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/metrics/fit-run/v3/run-summary.schema.json",
  "title": "Immutable Transformer successful fit run summary v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format", "recordedAt", "jobId", "attemptId", "attempt", "modelRef",
    "dataContractSha256", "objectiveConfigSha256", "checkpointFormat",
    "transformerVersion", "transformerGitCommit", "targets", "milestones", "durations",
    "counts"
  ],
  "properties": {
    "format": {"const": "transformer.fit-run-summary.v3"},
    "recordedAt": {"type": "string", "format": "date-time"},
    "jobId": {"type": "string", "format": "uuid"},
    "attemptId": {"type": "string", "format": "uuid"},
    "attempt": {"type": "integer", "minimum": 1},
    "modelRef": {"type": "string", "pattern": "^mdl_[0-9a-f]{32}$"},
    "dataContractSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "objectiveConfigSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpointFormat": {"type": "string", "minLength": 1, "maxLength": 64},
    "transformerVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "transformerGitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "targets": {
      "type": "array",
      "items": {
        "enum": [
          "MeanReturn", "SigmaReturn", "ProbTP", "ProbSL",
          "VolatilityNext", "HittingProbTP"
        ]
      },
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true
    },
    "milestones": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createdAt", "firstInputCommittedAt", "inputClosedAt",
        "workerCompletedAt", "publishedAt"
      ],
      "properties": {
        "createdAt": {"type": "string", "format": "date-time"},
        "firstInputCommittedAt": {"type": "string", "format": "date-time"},
        "inputClosedAt": {"type": "string", "format": "date-time"},
        "workerCompletedAt": {"type": "string", "format": "date-time"},
        "publishedAt": {"type": "string", "format": "date-time"}
      }
    },
    "durations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firstInputWaitMs", "eofWaitMs", "queueWaitMs", "workerStartupMs",
        "trainingMs", "checkpointSerializationMs", "checkpointPublicationMs",
        "modelPublicationMs", "remoteFitMs"
      ],
      "properties": {
        "firstInputWaitMs": {"type": "number", "minimum": 0},
        "eofWaitMs": {"type": "number", "minimum": 0},
        "queueWaitMs": {"type": "number", "minimum": 0},
        "workerStartupMs": {"type": "number", "minimum": 0},
        "trainingMs": {"type": "number", "minimum": 0},
        "checkpointSerializationMs": {"type": "number", "minimum": 0},
        "checkpointPublicationMs": {"type": "number", "minimum": 0},
        "modelPublicationMs": {"type": "number", "minimum": 0},
        "remoteFitMs": {"type": "number", "minimum": 0}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "recoveries", "inputPayloads", "inputRows", "inputBytes"],
      "properties": {
        "attempts": {"type": "integer", "minimum": 1},
        "recoveries": {"type": "integer", "minimum": 0},
        "inputPayloads": {"type": "integer", "minimum": 1},
        "inputRows": {"type": "integer", "minimum": 1},
        "inputBytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
