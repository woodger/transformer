{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/metrics/fit-run/v3/run-document.schema.json",
  "title": "OpenSearch Transformer fit run summary v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@timestamp", "schema", "summaryId", "documentSha256", "deploymentId",
    "runId", "source", "eventKind", "transformerJobId", "attemptId", "attempt",
    "modelRef", "dataContractSha256", "objectiveConfigSha256", "checkpointFormat",
    "transformerVersion", "transformerGitCommit", "targets", "milestones", "durations",
    "counts", "artifact"
  ],
  "properties": {
    "@timestamp": {"type": "string", "format": "date-time"},
    "schema": {"const": "inventory.metrics.fit-run.v3"},
    "summaryId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "documentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deploymentId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "runId": {"type": "string", "format": "uuid"},
    "source": {"const": "transformer"},
    "eventKind": {"const": "fit.run.succeeded"},
    "transformerJobId": {"type": "string", "format": "uuid"},
    "attemptId": {"type": "string", "format": "uuid"},
    "attempt": {"type": "integer", "minimum": 1},
    "modelRef": {"type": "string", "pattern": "^mdl_[0-9a-f]{32}$"},
    "dataContractSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "objectiveConfigSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpointFormat": {"type": "string", "minLength": 1, "maxLength": 64},
    "transformerVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "transformerGitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "targets": {
      "type": "array",
      "items": {
        "enum": [
          "MeanReturn", "SigmaReturn", "ProbTP", "ProbSL",
          "VolatilityNext", "HittingProbTP"
        ]
      },
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true
    },
    "milestones": {"$ref": "run-summary.schema.json#/properties/milestones"},
    "durations": {"$ref": "run-summary.schema.json#/properties/durations"},
    "counts": {"$ref": "run-summary.schema.json#/properties/counts"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "mediaType", "bytes", "sha256"],
      "properties": {
        "format": {"const": "transformer.fit-run-summary.v3"},
        "mediaType": {"const": "application/json"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
