{
  "index_patterns": ["metrics-runs-v2"],
  "priority": 300,
  "template": {
    "settings": {"number_of_replicas": 0},
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp": {"type": "date"},
        "schema": {"type": "keyword"},
        "summaryId": {"type": "keyword"},
        "documentSha256": {"type": "keyword"},
        "deploymentId": {"type": "keyword"},
        "runId": {"type": "keyword"},
        "source": {"type": "keyword"},
        "eventKind": {"type": "keyword"},
        "transformerJobId": {"type": "keyword"},
        "attemptId": {"type": "keyword"},
        "attempt": {"type": "integer"},
        "modelRef": {"type": "keyword"},
        "dataContractSha256": {"type": "keyword"},
        "objectiveConfigSha256": {"type": "keyword"},
        "checkpointFormat": {"type": "keyword"},
        "transformerVersion": {"type": "keyword"},
        "transformerGitCommit": {"type": "keyword"},
        "milestones": {
          "type": "object", "dynamic": "strict",
          "properties": {
            "createdAt": {"type": "date"},
            "firstInputCommittedAt": {"type": "date"},
            "inputClosedAt": {"type": "date"},
            "workerCompletedAt": {"type": "date"},
            "publishedAt": {"type": "date"}
          }
        },
        "durations": {
          "type": "object", "dynamic": "strict",
          "properties": {
            "firstInputWaitMs": {"type": "double"},
            "eofWaitMs": {"type": "double"},
            "queueWaitMs": {"type": "double"},
            "workerStartupMs": {"type": "double"},
            "trainingMs": {"type": "double"},
            "checkpointSerializationMs": {"type": "double"},
            "checkpointPublicationMs": {"type": "double"},
            "modelPublicationMs": {"type": "double"},
            "remoteFitMs": {"type": "double"}
          }
        },
        "counts": {
          "type": "object", "dynamic": "strict",
          "properties": {
            "attempts": {"type": "integer"},
            "recoveries": {"type": "integer"},
            "inputPayloads": {"type": "integer"},
            "inputRows": {"type": "long"},
            "inputBytes": {"type": "long"}
          }
        },
        "targetStatistics": {
          "type": "nested", "dynamic": "strict",
          "properties": {
            "targetIndex": {"type": "integer"},
            "name": {"type": "keyword"},
            "count": {"type": "long"},
            "min": {"type": "double"},
            "max": {"type": "double"},
            "mean": {"type": "double"},
            "std": {"type": "double"},
            "zeroCount": {"type": "long"},
            "oneCount": {"type": "long"}
          }
        },
        "artifact": {
          "type": "object", "dynamic": "strict",
          "properties": {
            "format": {"type": "keyword"},
            "mediaType": {"type": "keyword"},
            "bytes": {"type": "long"},
            "sha256": {"type": "keyword"}
          }
        }
      }
    }
  },
  "_meta": {"contract": "inventory.metrics.fit-run.v2", "owner": "transformer"}
}
