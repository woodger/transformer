{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/metrics/v4/point.schema.json",
  "title": "OpenSearch training metric point v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@timestamp", "schema", "eventId", "documentSha256", "deploymentId",
    "runId", "source", "eventKind", "transformerJobId", "attemptId",
    "attempt", "modelRef", "epoch", "step", "targets",
    "dataContractSha256", "objectiveConfigSha256", "checkpointFormat",
    "transformerVersion", "transformerGitCommit", "metric", "attributes"
  ],
  "properties": {
    "@timestamp": {"type": "string", "format": "date-time"},
    "schema": {"const": "inventory.metrics.point.v4"},
    "eventId": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "documentSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deploymentId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "runId": {"type": "string", "format": "uuid"},
    "source": {"const": "transformer"},
    "eventKind": {"const": "training.epoch"},
    "transformerJobId": {"type": "string", "format": "uuid"},
    "attemptId": {"type": "string", "format": "uuid"},
    "attempt": {"type": "integer", "minimum": 1},
    "modelRef": {"type": "string", "pattern": "^mdl_[0-9a-f]{32}$"},
    "frame": {"type": "integer", "minimum": 0},
    "epoch": {"type": "integer", "minimum": 1},
    "step": {"type": "integer", "minimum": 0},
    "targets": {
      "type": "array",
      "items": {
        "enum": [
          "MeanReturn", "SigmaReturn", "ProbTP", "ProbSL",
          "VolatilityNext", "HittingProbTP"
        ]
      },
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true
    },
    "target": {"$ref": "#/$defs/target"},
    "operator": {
      "enum": ["GaussianNLL", "ExpectedValue", "RiskAdjustedExpectedValue"]
    },
    "gradientComponent": {"type": "string", "minLength": 1},
    "gradientPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right"],
      "properties": {
        "left": {"type": "string", "minLength": 1},
        "right": {"type": "string", "minLength": 1}
      }
    },
    "dataContractSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "objectiveConfigSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "checkpointFormat": {"const": "transformer-checkpoint-v5"},
    "transformerVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "transformerGitCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "unit"],
      "properties": {
        "name": {
          "enum": [
            "training.loss.total", "training.loss.direct",
            "training.loss.auxiliary",
            "training.target.mae", "training.target.rmse",
            "training.selection.score", "training.batches.completed",
            "training.optimizer.updates.applied",
            "training.optimizer.updates.skipped",
            "training.amp.overflow_batches",
            "training.gradient.batches.finite",
            "training.gradient.batches.non_finite",
            "training.gradient.pre_clip_norm.mean",
            "training.gradient.pre_clip_norm.max",
            "training.gradient.pre_clip_norm.p95",
            "training.gradient.component.norm",
            "training.gradient.pair.cosine",
            "training.learning_rate", "training.input.nan_ratio",
            "training.input.masked_token_ratio",
            "training.input.complete_token_ratio",
            "training.input.partial_token_ratio",
            "training.input.empty_token_ratio",
            "training.phase.input_pipeline", "training.phase.missing_stats",
            "training.phase.host_to_device", "training.phase.train_step",
            "training.phase.epoch_elapsed"
          ]
        },
        "value": {"type": "number"},
        "unit": {"enum": ["1", "count", "ratio", "ms"]}
      }
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpointBest", "shouldStop", "bestSelectionScore"],
      "properties": {
        "checkpointBest": {"type": "boolean"},
        "shouldStop": {"type": "boolean"},
        "bestSelectionScore": {"type": ["number", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "metric": {
            "properties": {
              "name": {
                "enum": [
                  "training.loss.direct", "training.target.mae",
                  "training.target.rmse"
                ]
              }
            }
          }
        }
      },
      "then": {"required": ["target"]},
      "else": {"not": {"required": ["target"]}}
    },
    {
      "if": {
        "properties": {
          "metric": {"properties": {"name": {"const": "training.loss.auxiliary"}}}
        }
      },
      "then": {"required": ["operator"]},
      "else": {"not": {"required": ["operator"]}}
    },
    {
      "if": {
        "properties": {
          "metric": {
            "properties": {"name": {"const": "training.gradient.component.norm"}}
          }
        }
      },
      "then": {"required": ["gradientComponent"]},
      "else": {"not": {"required": ["gradientComponent"]}}
    },
    {
      "if": {
        "properties": {
          "metric": {
            "properties": {"name": {"const": "training.gradient.pair.cosine"}}
          }
        }
      },
      "then": {"required": ["gradientPair"]},
      "else": {"not": {"required": ["gradientPair"]}}
    }
  ],
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "name"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 5},
        "name": {
          "enum": [
            "MeanReturn", "SigmaReturn", "ProbTP", "ProbSL",
            "VolatilityNext", "HittingProbTP"
          ]
        }
      }
    }
  }
}
