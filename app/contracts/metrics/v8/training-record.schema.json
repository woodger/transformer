{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/metrics/v8/training-record.schema.json",
  "title": "Transformer immutable training metrics record v8",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "recordedAt",
    "jobId",
    "attemptId",
    "attempt",
    "modelRef",
    "semanticDigests",
    "checkpointFormat",
    "transformerVersion",
    "transformerGitCommit",
    "mode",
    "frame",
    "epoch",
    "step",
    "rows",
    "batches",
    "lr",
    "loss",
    "targets",
    "directLosses",
    "auxiliaryLosses",
    "targetMetrics",
    "gradientInteractions",
    "selectionScore",
    "trainingBatchesCompleted",
    "optimizerUpdatesApplied",
    "optimizerUpdatesSkipped",
    "ampOverflowBatches",
    "finiteGradientBatches",
    "nonFiniteGradientBatches",
    "preClipGradientNormMean",
    "preClipGradientNormMax",
    "preClipGradientNormP95",
    "nanRatio",
    "maskedTokenRatio",
    "completeTokenRatio",
    "partialTokenRatio",
    "emptyTokenRatio",
    "inputPipelineMs",
    "missingStatsMs",
    "hostToDeviceMs",
    "trainStepMs",
    "elapsedMs",
    "checkpointBest",
    "shouldStop",
    "bestSelectionScore"
  ],
  "properties": {
    "format": {
      "const": "transformer.training-metrics.v8"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "jobId": {
      "type": "string",
      "format": "uuid"
    },
    "attemptId": {
      "type": "string",
      "format": "uuid"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "modelRef": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^mdl_[0-9a-f]{32}$"
    },
    "semanticDigests": {
      "$ref": "https://transformer.local/contracts/semantic/v4/semantic-digests.schema.json"
    },
    "checkpointFormat": {
      "const": "transformer-checkpoint-v9"
    },
    "transformerVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "transformerGitCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "mode": {
      "const": "fit-stream"
    },
    "frame": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "step": {
      "type": "integer",
      "minimum": 0
    },
    "rows": {
      "type": "integer",
      "minimum": 1
    },
    "batches": {
      "type": "integer",
      "minimum": 1
    },
    "lr": {
      "type": "number",
      "minimum": 0
    },
    "loss": {
      "type": "number"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "directLosses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/directLoss"
      }
    },
    "auxiliaryLosses": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/auxiliaryLoss"
      }
    },
    "targetMetrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/targetMetrics"
      }
    },
    "gradientInteractions": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/gradientInteractions"
        }
      ]
    },
    "selectionScore": {
      "type": [
        "number",
        "null"
      ]
    },
    "trainingBatchesCompleted": {
      "type": "integer",
      "minimum": 1
    },
    "optimizerUpdatesApplied": {
      "type": "integer",
      "minimum": 0
    },
    "optimizerUpdatesSkipped": {
      "type": "integer",
      "minimum": 0
    },
    "ampOverflowBatches": {
      "type": "integer",
      "minimum": 0
    },
    "finiteGradientBatches": {
      "type": "integer",
      "minimum": 0
    },
    "nonFiniteGradientBatches": {
      "type": "integer",
      "minimum": 0
    },
    "preClipGradientNormMean": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "preClipGradientNormMax": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "preClipGradientNormP95": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "nanRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "maskedTokenRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "completeTokenRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "partialTokenRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "emptyTokenRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "inputPipelineMs": {
      "type": "number",
      "minimum": 0
    },
    "missingStatsMs": {
      "type": "number",
      "minimum": 0
    },
    "hostToDeviceMs": {
      "type": "number",
      "minimum": 0
    },
    "trainStepMs": {
      "type": "number",
      "minimum": 0
    },
    "elapsedMs": {
      "type": "number",
      "minimum": 0
    },
    "checkpointBest": {
      "type": "boolean"
    },
    "shouldStop": {
      "type": "boolean"
    },
    "bestSelectionScore": {
      "type": [
        "number",
        "null"
      ]
    }
  },
  "$defs": {
    "identity": {
      "$ref": "https://transformer.local/contracts/semantic/v4/common.schema.json#/$defs/identity"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index",
        "identity"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 0
        },
        "identity": {
          "$ref": "#/$defs/identity"
        }
      }
    },
    "directLoss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentIdentity",
        "operator",
        "targetIdentity",
        "targetIndex",
        "value"
      ],
      "properties": {
        "componentIdentity": {
          "$ref": "#/$defs/identity"
        },
        "operator": {
          "$ref": "#/$defs/identity"
        },
        "targetIdentity": {
          "$ref": "#/$defs/identity"
        },
        "targetIndex": {
          "type": "integer",
          "minimum": 0
        },
        "value": {
          "type": "number"
        }
      }
    },
    "auxiliaryLoss": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentIdentity",
        "operator",
        "value"
      ],
      "properties": {
        "componentIdentity": {
          "$ref": "#/$defs/identity"
        },
        "operator": {
          "$ref": "#/$defs/identity"
        },
        "value": {
          "type": "number"
        }
      }
    },
    "targetMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetIdentity",
        "targetIndex",
        "mae",
        "rmse"
      ],
      "properties": {
        "targetIdentity": {
          "$ref": "#/$defs/identity"
        },
        "targetIndex": {
          "type": "integer",
          "minimum": 0
        },
        "mae": {
          "type": "number",
          "minimum": 0
        },
        "rmse": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "gradientInteractions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "samples",
        "components",
        "pairs"
      ],
      "properties": {
        "samples": {
          "type": "integer",
          "minimum": 1
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "componentIdentity",
              "meanNorm"
            ],
            "properties": {
              "componentIdentity": {
                "$ref": "#/$defs/identity"
              },
              "targetIdentity": {
                "$ref": "#/$defs/identity"
              },
              "targetIndex": {
                "type": "integer",
                "minimum": 0
              },
              "meanNorm": {
                "type": "number",
                "minimum": 0
              }
            },
            "dependentRequired": {
              "targetIdentity": [
                "targetIndex"
              ],
              "targetIndex": [
                "targetIdentity"
              ]
            }
          }
        },
        "pairs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "leftComponentIdentity",
              "rightComponentIdentity",
              "meanCosine",
              "negativeCosineFraction"
            ],
            "properties": {
              "leftComponentIdentity": {
                "$ref": "#/$defs/identity"
              },
              "rightComponentIdentity": {
                "$ref": "#/$defs/identity"
              },
              "meanCosine": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "negativeCosineFraction": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        }
      }
    }
  }
}
