{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/target-head-diagnostics/v2/common.schema.json",
  "title": "Transformer target head diagnostics query v2 common definitions",
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeInteger": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "positiveInteger": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "modelRef": {"type": "string", "pattern": "^mdl_[0-9a-f]{32}$"},
    "identity": {"$ref": "https://transformer.local/contracts/semantic/v4/common.schema.json#/$defs/identity"},
    "timestamp": {"type": "string", "format": "date-time"},
    "cursor": {"type": "string", "minLength": 48, "maxLength": 1029, "pattern": "^thd2\\.[A-Za-z0-9_-]{43,1024}$"},
    "sampleIdentity": {"type": "string", "pattern": "^thds_[0-9a-f]{64}$"},
    "targetHeadLayoutItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetIdentity", "targetIndex", "directComponentIdentity"],
      "properties": {
        "targetIdentity": {"$ref": "#/$defs/identity"},
        "targetIndex": {"$ref": "#/$defs/safeInteger"},
        "directComponentIdentity": {"$ref": "#/$defs/identity"}
      }
    },
    "rowRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rowCenteredL2Mean"],
      "properties": {
        "rowCenteredL2Mean": {"type": "number", "minimum": 0}
      }
    },
    "encoderLayerRepresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layerIndex", "rowCenteredL2Mean"],
      "properties": {
        "layerIndex": {"$ref": "#/$defs/safeInteger"},
        "rowCenteredL2Mean": {"type": "number", "minimum": 0}
      }
    },
    "representationFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoderInput", "encoderLayers", "targetHeadInput"],
      "properties": {
        "encoderInput": {"$ref": "#/$defs/rowRepresentation"},
        "encoderLayers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/encoderLayerRepresentation"}
        },
        "targetHeadInput": {"$ref": "#/$defs/rowRepresentation"}
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rowCount", "minimum", "maximum", "mean", "standardDeviation"],
      "properties": {
        "rowCount": {"$ref": "#/$defs/positiveInteger"},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "mean": {"type": "number"},
        "standardDeviation": {"type": "number", "minimum": 0}
      }
    },
    "targetHead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawLogit", "publicPrediction", "gradientL2Mean", "gradientL2Maximum", "gradientBatchCount", "weightL2AfterEpoch", "biasAfterEpoch"],
      "properties": {
        "rawLogit": {"$ref": "#/$defs/distribution"},
        "publicPrediction": {"$ref": "#/$defs/distribution"},
        "gradientL2Mean": {"type": ["number", "null"], "minimum": 0},
        "gradientL2Maximum": {"type": ["number", "null"], "minimum": 0},
        "gradientBatchCount": {"$ref": "#/$defs/safeInteger"},
        "weightL2AfterEpoch": {"type": "number", "minimum": 0},
        "biasAfterEpoch": {"type": "number"}
      },
      "oneOf": [
        {
          "properties": {
            "gradientL2Mean": {"type": "null"},
            "gradientL2Maximum": {"type": "null"},
            "gradientBatchCount": {"const": 0}
          }
        },
        {
          "properties": {
            "gradientL2Mean": {"type": "number", "minimum": 0},
            "gradientL2Maximum": {"type": "number", "minimum": 0},
            "gradientBatchCount": {"$ref": "#/$defs/positiveInteger"}
          }
        }
      ]
    },
    "epochObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch", "globalStep", "representationFlow", "targetHeads"],
      "properties": {
        "epoch": {"$ref": "#/$defs/positiveInteger"},
        "globalStep": {"$ref": "#/$defs/safeInteger"},
        "representationFlow": {"$ref": "#/$defs/representationFlow"},
        "targetHeads": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/targetHead"}}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completedEpochs"],
      "properties": {"completedEpochs": {"$ref": "#/$defs/positiveInteger"}}
    },
    "epochPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["items", "nextCursor", "cursorExpiresAt"],
      "properties": {
        "items": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/epochObservation"}},
        "nextCursor": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/cursor"}]},
        "cursorExpiresAt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]}
      }
    }
  }
}
