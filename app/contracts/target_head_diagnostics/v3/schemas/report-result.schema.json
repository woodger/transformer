{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/target-head-diagnostics/v3/report-result.schema.json",
  "title": "transformer.target-head-diagnostics.v3.report result",
  "oneOf": [
    {"$ref": "#/$defs/notConfigured"},
    {"$ref": "#/$defs/pending"},
    {"$ref": "#/$defs/unavailable"},
    {"$ref": "#/$defs/available"}
  ],
  "$defs": {
    "notConfigured": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "state", "modelRef", "reason"],
      "properties": {
        "requestId": {"$ref": "common.schema.json#/$defs/uuid"},
        "state": {"const": "notConfigured"},
        "modelRef": {"$ref": "common.schema.json#/$defs/modelRef"},
        "reason": {"const": "TARGET_HEAD_DIAGNOSTICS_NOT_CONFIGURED"}
      }
    },
    "pending": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "state", "modelRef", "reason", "retryAfterSeconds"],
      "properties": {
        "requestId": {"$ref": "common.schema.json#/$defs/uuid"},
        "state": {"const": "pending"},
        "modelRef": {"$ref": "common.schema.json#/$defs/modelRef"},
        "reason": {"const": "MATERIALIZATION_PENDING"},
        "retryAfterSeconds": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    },
    "unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "state", "modelRef", "reason"],
      "properties": {
        "requestId": {"$ref": "common.schema.json#/$defs/uuid"},
        "state": {"const": "unavailable"},
        "modelRef": {"$ref": "common.schema.json#/$defs/modelRef"},
        "reason": {"enum": ["NO_COMPLETE_REPORT", "RETENTION_EXPIRED", "FORMAT_UNSUPPORTED"]}
      }
    },
    "available": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestId", "state", "modelRef", "producingRunId", "modelDefinitionSha256", "sampleIdentity", "sampleRowCount", "layout", "coverage", "epochPage"],
      "properties": {
        "requestId": {"$ref": "common.schema.json#/$defs/uuid"},
        "state": {"const": "available"},
        "modelRef": {"$ref": "common.schema.json#/$defs/modelRef"},
        "producingRunId": {"$ref": "common.schema.json#/$defs/uuid"},
        "modelDefinitionSha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "sampleIdentity": {"$ref": "common.schema.json#/$defs/sampleIdentity"},
        "sampleRowCount": {"$ref": "common.schema.json#/$defs/positiveInteger"},
        "layout": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "common.schema.json#/$defs/targetHeadLayoutItem"}},
        "coverage": {"$ref": "common.schema.json#/$defs/coverage"},
        "epochPage": {"$ref": "common.schema.json#/$defs/epochPage"}
      }
    }
  }
}
