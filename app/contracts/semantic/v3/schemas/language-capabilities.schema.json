{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/semantic/v3/language-capabilities.schema.json",
  "title": "Consumer-neutral objective language capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objectiveLanguage",
    "semanticLimits"
  ],
  "properties": {
    "objectiveLanguage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "closed"
      ],
      "properties": {
        "revision": {
          "const": 3
        },
        "closed": {
          "const": true
        }
      }
    },
    "semanticLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxTargetSlots",
        "maxObjectiveComponents",
        "maxPrivateResources"
      ],
      "properties": {
        "maxTargetSlots": {
          "$ref": "common.schema.json#/$defs/positiveInteger"
        },
        "maxObjectiveComponents": {
          "$ref": "common.schema.json#/$defs/positiveInteger"
        },
        "maxPrivateResources": {
          "$ref": "common.schema.json#/$defs/positiveInteger"
        }
      }
    }
  }
}
