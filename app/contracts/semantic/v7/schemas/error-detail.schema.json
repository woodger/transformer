{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/semantic/v7/error-detail.schema.json",
  "title": "Semantic error detail",
  "oneOf": [
    {
      "$ref": "#/$defs/requestContractError"
    },
    {
      "$ref": "#/$defs/availabilityError"
    },
    {
      "$ref": "#/$defs/targetValueError"
    },
    {
      "$ref": "#/$defs/mismatchError"
    },
    {
      "$ref": "#/$defs/corruptContractError"
    },
    {
      "$ref": "#/$defs/corruptDigestError"
    },
    {
      "$ref": "#/$defs/recoveryError"
    },
    {
      "$ref": "#/$defs/runtimeError"
    }
  ],
  "$defs": {
    "code": {
      "enum": [
        "INVALID_ARGUMENT",
        "FAILED_PRECONDITION",
        "MODEL_SCHEMA_MISMATCH",
        "MODEL_CORRUPT",
        "RECOVERY_CHECKPOINT_INCOMPATIBLE",
        "WORKER_PROTOCOL_VIOLATION",
        "MALFORMED_OUTPUT"
      ]
    },
    "reason": {
      "enum": [
        "INVALID_TARGET_CONTRACT",
        "INVALID_OBJECTIVE",
        "INVALID_RESOURCE_GRAPH",
        "INVALID_MODEL_CONTRACT",
        "UNKNOWN_PRIMITIVE",
        "LANGUAGE_REVISION_UNAVAILABLE",
        "PRIMITIVE_UNAVAILABLE",
        "TARGET_VALUE_INVALID",
        "DIGEST_MISMATCH",
        "STORED_CONTRACT_INVALID",
        "RECOVERY_FENCE_MISMATCH",
        "NON_FINITE_RUNTIME_VALUE",
        "INVALID_RUNTIME_SHAPE"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "pointer": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
    },
    "layer": {
      "enum": [
        "data",
        "target",
        "objective",
        "model",
        "jobConfig",
        "inputManifest"
      ]
    },
    "requestContractError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reason",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "const": "INVALID_ARGUMENT"
        },
        "reason": {
          "enum": [
            "INVALID_TARGET_CONTRACT",
            "INVALID_OBJECTIVE",
            "INVALID_RESOURCE_GRAPH",
            "INVALID_MODEL_CONTRACT",
            "UNKNOWN_PRIMITIVE"
          ]
        },
        "path": {
          "$ref": "#/$defs/pointer"
        },
        "message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "availabilityError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reason",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "const": "FAILED_PRECONDITION"
        },
        "reason": {
          "enum": [
            "LANGUAGE_REVISION_UNAVAILABLE",
            "PRIMITIVE_UNAVAILABLE"
          ]
        },
        "path": {
          "$ref": "#/$defs/pointer"
        },
        "message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "targetValueError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reason",
        "targetIdentity",
        "targetIndex",
        "logicalRow",
        "message"
      ],
      "properties": {
        "code": {
          "const": "INVALID_ARGUMENT"
        },
        "reason": {
          "const": "TARGET_VALUE_INVALID"
        },
        "targetIdentity": {
          "$ref": "common.schema.json#/$defs/identity"
        },
        "targetIndex": {
          "$ref": "common.schema.json#/$defs/safeInteger"
        },
        "logicalRow": {
          "$ref": "common.schema.json#/$defs/safeInteger"
        },
        "expectedDomain": {
          "const": "Binary"
        },
        "message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "mismatchError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reason",
        "layer",
        "expectedSha256",
        "actualSha256",
        "message"
      ],
      "properties": {
        "code": {
          "const": "MODEL_SCHEMA_MISMATCH"
        },
        "reason": {
          "const": "DIGEST_MISMATCH"
        },
        "layer": {
          "enum": [
            "data",
            "target",
            "objective",
            "model"
          ]
        },
        "expectedSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "actualSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "corruptContractError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reason",
        "layer",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "const": "MODEL_CORRUPT"
        },
        "reason": {
          "const": "STORED_CONTRACT_INVALID"
        },
        "layer": {
          "enum": [
            "data",
            "target",
            "objective",
            "model"
          ]
        },
        "path": {
          "$ref": "#/$defs/pointer"
        },
        "message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "corruptDigestError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reason",
        "layer",
        "expectedSha256",
        "actualSha256",
        "message"
      ],
      "properties": {
        "code": {
          "const": "MODEL_CORRUPT"
        },
        "reason": {
          "const": "DIGEST_MISMATCH"
        },
        "layer": {
          "enum": [
            "data",
            "target",
            "objective",
            "model"
          ]
        },
        "expectedSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "actualSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "recoveryError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reason",
        "layer",
        "expectedSha256",
        "actualSha256",
        "message"
      ],
      "properties": {
        "code": {
          "const": "RECOVERY_CHECKPOINT_INCOMPATIBLE"
        },
        "reason": {
          "const": "RECOVERY_FENCE_MISMATCH"
        },
        "layer": {
          "$ref": "#/$defs/layer"
        },
        "expectedSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "actualSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "message": {
          "$ref": "#/$defs/message"
        }
      }
    },
    "runtimeError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reason",
        "message"
      ],
      "properties": {
        "code": {
          "enum": [
            "WORKER_PROTOCOL_VIOLATION",
            "MALFORMED_OUTPUT"
          ]
        },
        "reason": {
          "enum": [
            "NON_FINITE_RUNTIME_VALUE",
            "INVALID_RUNTIME_SHAPE"
          ]
        },
        "message": {
          "$ref": "#/$defs/message"
        }
      }
    }
  }
}
