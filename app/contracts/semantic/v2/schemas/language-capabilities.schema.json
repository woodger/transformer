{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/semantic/v2/language-capabilities.schema.json",
  "title": "Consumer-neutral objective language capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objectiveLanguage",
    "semanticLimits",
    "modelArchitectures"
  ],
  "properties": {
    "objectiveLanguage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "constraints",
        "transformations",
        "resourceClasses",
        "directOperators",
        "auxiliaryOperators",
        "aggregations",
        "reductions"
      ],
      "properties": {
        "revision": {
          "const": 2
        },
        "constraints": {
          "$ref": "#/$defs/identitySet"
        },
        "transformations": {
          "$ref": "#/$defs/identitySet"
        },
        "directOperators": {
          "$ref": "#/$defs/identitySet"
        },
        "auxiliaryOperators": {
          "$ref": "#/$defs/identitySet"
        },
        "aggregations": {
          "$ref": "#/$defs/identitySet"
        },
        "reductions": {
          "$ref": "#/$defs/identitySet"
        },
        "resourceClasses": {
          "$ref": "#/$defs/identitySet"
        }
      }
    },
    "semanticLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxTargetSlots",
        "maxObjectiveComponents",
        "maxPrivateResources"
      ],
      "properties": {
        "maxTargetSlots": {
          "$ref": "common.schema.json#/$defs/positiveInteger"
        },
        "maxObjectiveComponents": {
          "$ref": "common.schema.json#/$defs/positiveInteger"
        },
        "maxPrivateResources": {
          "$ref": "common.schema.json#/$defs/positiveInteger"
        }
      }
    },
    "modelArchitectures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/architecture"
      }
    }
  },
  "$defs": {
    "identitySet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/identity"
      }
    }
  }
}
