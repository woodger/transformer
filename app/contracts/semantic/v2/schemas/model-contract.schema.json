{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/semantic/v2/model-contract.schema.json",
  "title": "Consumer-neutral ModelContract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objectiveLanguageRevision",
    "targetContract",
    "objective",
    "modelConfig"
  ],
  "properties": {
    "objectiveLanguageRevision": {
      "const": 2
    },
    "targetContract": {
      "$ref": "target-contract.schema.json"
    },
    "objective": {
      "$ref": "objective.schema.json"
    },
    "modelConfig": {
      "$ref": "common.schema.json#/$defs/modelConfig"
    }
  }
}
