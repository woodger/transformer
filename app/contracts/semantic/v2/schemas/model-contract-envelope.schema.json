{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/semantic/v2/model-contract-envelope.schema.json",
  "title": "Objective-language-neutral ModelContract envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
