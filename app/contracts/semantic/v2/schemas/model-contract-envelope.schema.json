    "targetContract",
    "objective",
    "modelConfig"
  ],
  "properties": {
    "objectiveLanguageRevision": {
      "$ref": "https://transformer.local/contracts/semantic/v2/common.schema.json#/$defs/positiveInteger"
    },
    "targetContract": {
      "type": "object"
    },
    "objective": {
      "type": "object"
    },
    "modelConfig": {
      "$ref": "https://transformer.local/contracts/semantic/v2/common.schema.json#/$defs/modelConfig"
    }
  }
}
