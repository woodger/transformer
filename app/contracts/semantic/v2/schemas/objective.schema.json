{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/semantic/v2/objective.schema.json",
  "title": "Consumer-neutral Objective v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "aggregation",
    "reduction",
    "resources",
    "directComponents",
    "auxiliaryComponents"
  ],
  "properties": {
    "aggregation": {
      "const": "WeightedSum"
    },
    "reduction": {
      "const": "GlobalRowMean"
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/resourceDeclaration"
      }
    },
    "directComponents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/directComponent"
      }
    },
    "auxiliaryComponents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/auxiliaryComponent"
      }
    }
  },
  "$defs": {
    "componentBase": {
      "type": "object",
      "required": [
        "identity",
        "operator",
        "weight",
        "roles",
        "parameters"
      ],
      "properties": {
        "identity": {
          "$ref": "common.schema.json#/$defs/identity"
        },
        "weight": {
          "$ref": "common.schema.json#/$defs/positiveNumber"
        }
      }
    },
    "smoothL1": {
      "allOf": [
        {
          "$ref": "#/$defs/componentBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": true,
            "operator": {
              "const": "SmoothL1"
            },
            "weight": true,
            "roles": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "estimate",
                "observed"
              ],
              "properties": {
                "estimate": {
                  "$ref": "common.schema.json#/$defs/targetLossEstimateRef"
                },
                "observed": {
                  "$ref": "common.schema.json#/$defs/targetObservedRef"
                }
              }
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "binaryCrossEntropy": {
      "allOf": [
        {
          "$ref": "#/$defs/componentBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": true,
            "operator": {
              "const": "BinaryCrossEntropyWithLogits"
            },
            "weight": true,
            "roles": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "logit",
                "probability"
              ],
              "properties": {
                "logit": {
                  "$ref": "common.schema.json#/$defs/targetLossEstimateRef"
                },
                "probability": {
                  "$ref": "common.schema.json#/$defs/targetObservedRef"
                }
              }
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "logMse": {
      "allOf": [
        {
          "$ref": "#/$defs/componentBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": true,
            "operator": {
              "const": "LogMSE"
            },
            "weight": true,
            "roles": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "estimate",
                "observed"
              ],
              "properties": {
                "estimate": {
                  "$ref": "common.schema.json#/$defs/targetLossEstimateRef"
                },
                "observed": {
                  "$ref": "common.schema.json#/$defs/targetObservedRef"
                }
              }
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "directComponent": {
      "oneOf": [
        {
          "$ref": "#/$defs/smoothL1"
        },
        {
          "$ref": "#/$defs/binaryCrossEntropy"
        },
        {
          "$ref": "#/$defs/logMse"
        },
        {
          "$ref": "#/$defs/additiveDirectComponent"
        }
      ]
    },
    "additiveDirectComponent": {
      "allOf": [
        {
          "$ref": "#/$defs/componentBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": true,
            "operator": {
              "allOf": [
                {
                  "$ref": "common.schema.json#/$defs/identity"
                },
                {
                  "not": {
                    "enum": [
                      "SmoothL1",
                      "BinaryCrossEntropyWithLogits",
                      "LogMSE"
                    ]
                  }
                }
              ]
            },
            "weight": true,
            "roles": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "allOf": [
                  {
                    "$ref": "common.schema.json#/$defs/identity"
                  },
                  {
                    "not": {
                      "const": "kind"
                    }
                  }
                ]
              },
              "additionalProperties": {
                "$ref": "common.schema.json#/$defs/valueReference"
              }
            },
            "parameters": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "kind"
                }
              },
              "additionalProperties": {
                "$ref": "common.schema.json#/$defs/kindFreeJsonValue"
              }
            }
          }
        }
      ]
    },
    "gaussianNll": {
      "allOf": [
        {
          "$ref": "#/$defs/componentBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": true,
            "operator": {
              "const": "GaussianNLL"
            },
            "weight": true,
            "roles": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "locationEstimate",
                "observedLocation",
                "scale"
              ],
              "properties": {
                "locationEstimate": {
                  "$ref": "common.schema.json#/$defs/targetLossEstimateRef"
                },
                "observedLocation": {
                  "$ref": "common.schema.json#/$defs/targetObservedRef"
                },
                "scale": {
                  "$ref": "common.schema.json#/$defs/resourceRef"
                }
              }
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "expectedValue": {
      "allOf": [
        {
          "$ref": "#/$defs/componentBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": true,
            "operator": {
              "const": "ExpectedValue"
            },
            "weight": true,
            "roles": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "positiveOutcomeProbability",
                "negativeOutcomeProbability"
              ],
              "properties": {
                "positiveOutcomeProbability": {
                  "$ref": "common.schema.json#/$defs/targetPublicPredictionRef"
                },
                "negativeOutcomeProbability": {
                  "$ref": "common.schema.json#/$defs/targetPublicPredictionRef"
                }
              }
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false
            }
          }
        }
      ]
    },
    "riskAdjustedExpectedValue": {
      "allOf": [
        {
          "$ref": "#/$defs/componentBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": true,
            "operator": {
              "const": "RiskAdjustedExpectedValue"
            },
            "weight": true,
            "roles": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "positiveOutcomeProbability",
                "negativeOutcomeProbability",
                "uncertaintyScale"
              ],
              "properties": {
                "positiveOutcomeProbability": {
                  "$ref": "common.schema.json#/$defs/targetPublicPredictionRef"
                },
                "negativeOutcomeProbability": {
                  "$ref": "common.schema.json#/$defs/targetPublicPredictionRef"
                },
                "uncertaintyScale": {
                  "$ref": "common.schema.json#/$defs/resourceRef"
                }
              }
            },
            "parameters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "riskPenalty"
              ],
              "properties": {
                "riskPenalty": {
                  "$ref": "common.schema.json#/$defs/positiveNumber"
                }
              }
            }
          }
        }
      ]
    },
    "auxiliaryComponent": {
      "oneOf": [
        {
          "$ref": "#/$defs/gaussianNll"
        },
        {
          "$ref": "#/$defs/expectedValue"
        },
        {
          "$ref": "#/$defs/riskAdjustedExpectedValue"
        },
        {
          "$ref": "#/$defs/additiveAuxiliaryComponent"
        }
      ]
    },
    "additiveAuxiliaryComponent": {
      "allOf": [
        {
          "$ref": "#/$defs/componentBase"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": true,
            "operator": {
              "allOf": [
                {
                  "$ref": "common.schema.json#/$defs/identity"
                },
                {
                  "not": {
                    "enum": [
                      "GaussianNLL",
                      "ExpectedValue",
                      "RiskAdjustedExpectedValue"
                    ]
                  }
                }
              ]
            },
            "weight": true,
            "roles": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "allOf": [
                  {
                    "$ref": "common.schema.json#/$defs/identity"
                  },
                  {
                    "not": {
                      "const": "kind"
                    }
                  }
                ]
              },
              "additionalProperties": {
                "$ref": "common.schema.json#/$defs/valueReference"
              }
            },
            "parameters": {
              "type": "object",
              "propertyNames": {
                "not": {
                  "const": "kind"
                }
              },
              "additionalProperties": {
                "$ref": "common.schema.json#/$defs/kindFreeJsonValue"
              }
            }
          }
        }
      ]
    }
  }
}
