{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/semantic/v6/target-contract.schema.json",
  "title": "TargetContract v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slots"
  ],
  "properties": {
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "lossInputTransformation",
          "publicPredictionTransformation"
        ],
        "properties": {
          "identity": {
            "$ref": "common.schema.json#/$defs/identity"
          },
          "observedConstraint": {
            "$ref": "common.schema.json#/$defs/constraint"
          },
          "lossInputTransformation": {
            "$ref": "common.schema.json#/$defs/transformation"
          },
          "publicPredictionTransformation": {
            "$ref": "common.schema.json#/$defs/transformation"
          }
        }
      }
    }
  }
}
