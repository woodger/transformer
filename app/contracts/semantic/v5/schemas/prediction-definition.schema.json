{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/semantic/v5/prediction-definition.schema.json",
  "title": "Разрешённое описание публичного предсказания",
  "type": "object",
  "additionalProperties": false,
  "required": ["seqLen", "outputWidth", "targets"],
  "properties": {
    "seqLen": {"$ref": "common.schema.json#/$defs/positiveInteger"},
    "outputWidth": {"$ref": "common.schema.json#/$defs/positiveInteger"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/predictionTarget"}
    }
  },
  "$defs": {
    "predictionTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["identity", "publicPredictionTransformation"],
          "properties": {
            "identity": {"$ref": "common.schema.json#/$defs/identity"},
            "publicPredictionTransformation": {
              "$ref": "common.schema.json#/$defs/transformation"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "identity",
            "publicPredictionTransformation",
            "positiveClassWeight"
          ],
          "properties": {
            "identity": {"$ref": "common.schema.json#/$defs/identity"},
            "publicPredictionTransformation": {"const": "Sigmoid"},
            "positiveClassWeight": {
              "$ref": "common.schema.json#/$defs/positiveNumber"
            }
          }
        }
      ]
    }
  }
}
