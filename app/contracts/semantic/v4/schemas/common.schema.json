{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/semantic/v4/common.schema.json",
  "title": "Semantic contract v4 common definitions",
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "positiveNumber": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint",
        "minimum",
        "maximum"
      ],
      "properties": {
        "constraint": {
          "const": "ClosedInterval"
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    },
    "transformation": {
      "type": "string",
      "enum": [
        "Identity",
        "Tanh",
        "Sigmoid"
      ]
    },
    "resourceDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "resourceClass"
      ],
      "properties": {
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "resourceClass": {
          "const": "PositiveScalarPerObservation"
        }
      }
    },
    "modelTuning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hiddenWidth",
        "encoderLayerCount",
        "attentionHeadCount",
        "dropoutProbability",
        "missingValuePolicy"
      ],
      "properties": {
        "hiddenWidth": {
          "$ref": "#/$defs/positiveInteger"
        },
        "encoderLayerCount": {
          "$ref": "#/$defs/positiveInteger"
        },
        "attentionHeadCount": {
          "$ref": "#/$defs/positiveInteger"
        },
        "dropoutProbability": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "missingValuePolicy": {
          "enum": [
            "strict",
            "relaxed"
          ]
        }
      }
    },
    "semanticDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataContractSha256",
        "targetContractSha256",
        "objectiveSha256",
        "modelDefinitionSha256"
      ],
      "properties": {
        "dataContractSha256": {
          "$ref": "#/$defs/sha256"
        },
        "targetContractSha256": {
          "$ref": "#/$defs/sha256"
        },
        "objectiveSha256": {
          "$ref": "#/$defs/sha256"
        },
        "modelDefinitionSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
