{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/semantic/v1/negative-cases.schema.json",
  "title": "Consumer-neutral semantic negative-case catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "cases"],
  "properties": {
    "contract": {"const": "transformer-consumer-neutral-negative-fixtures"},
    "version": {"const": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identity", "expectedCode", "expectedReason"],
        "properties": {
          "identity": {"$ref": "common.schema.json#/$defs/identity"},
          "fixturePath": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
          },
          "expectedCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
          "expectedReason": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
          "expectedLayer": {"enum": ["data", "target", "objective", "model", "jobConfig", "inputManifest"]}
        }
      }
    }
  }
}
