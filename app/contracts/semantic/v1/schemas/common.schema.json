{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/semantic/v1/common.schema.json",
  "title": "Consumer-neutral semantic contract v1 common definitions",
  "$defs": {
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "positiveNumber": {"type": "number", "exclusiveMinimum": 0},
    "constraint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "Finite"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "minimum", "maximum"],
          "properties": {
            "kind": {"const": "ClosedInterval"},
            "minimum": {"type": "number"},
            "maximum": {"type": "number"}
          }
        }
      ]
    },
    "transformation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {"kind": {"enum": ["Identity", "Tanh", "Sigmoid"]}}
    },
    "targetObservedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "view"],
      "properties": {
        "kind": {"const": "target"},
        "identity": {"$ref": "#/$defs/identity"},
        "view": {"const": "observed"}
      }
    },
    "targetLossEstimateRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "view"],
      "properties": {
        "kind": {"const": "target"},
        "identity": {"$ref": "#/$defs/identity"},
        "view": {"const": "lossEstimate"}
      }
    },
    "targetPublicPredictionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "view"],
      "properties": {
        "kind": {"const": "target"},
        "identity": {"$ref": "#/$defs/identity"},
        "view": {"const": "publicPrediction"}
      }
    },
    "resourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity"],
      "properties": {
        "kind": {"const": "resource"},
        "identity": {"$ref": "#/$defs/identity"}
      }
    },
    "valueReference": {
      "oneOf": [
        {"$ref": "#/$defs/targetObservedRef"},
        {"$ref": "#/$defs/targetLossEstimateRef"},
        {"$ref": "#/$defs/targetPublicPredictionRef"},
        {"$ref": "#/$defs/resourceRef"}
      ]
    },
    "resourceDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "kind"],
      "properties": {
        "identity": {"$ref": "#/$defs/identity"},
        "kind": {"const": "PositiveScalarPerObservation"}
      }
    },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "revision"],
      "properties": {
        "identity": {"$ref": "#/$defs/identity"},
        "revision": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "modelConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architecture", "seqLen", "featureDim", "hidden", "layers",
        "dropout", "nhead", "mode"
      ],
      "properties": {
        "architecture": {"$ref": "#/$defs/architecture"},
        "seqLen": {"$ref": "#/$defs/positiveInteger"},
        "featureDim": {"$ref": "#/$defs/positiveInteger"},
        "hidden": {"$ref": "#/$defs/positiveInteger"},
        "layers": {"$ref": "#/$defs/positiveInteger"},
        "dropout": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "nhead": {"$ref": "#/$defs/positiveInteger"},
        "mode": {"enum": ["strict", "relaxed"]}
      }
    },
    "dataContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity", "revision", "profile", "dataContractSha256", "seqLen",
        "featureDim"
      ],
      "properties": {
        "identity": {"$ref": "#/$defs/identity"},
        "revision": {"$ref": "#/$defs/positiveInteger"},
        "profile": {"$ref": "#/$defs/identity"},
        "dataContractSha256": {"$ref": "#/$defs/sha256"},
        "seqLen": {"$ref": "#/$defs/positiveInteger"},
        "featureDim": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "semanticDigests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataContractSha256", "targetContractSha256", "objectiveSha256",
        "modelContractSha256"
      ],
      "properties": {
        "dataContractSha256": {"$ref": "#/$defs/sha256"},
        "targetContractSha256": {"$ref": "#/$defs/sha256"},
        "objectiveSha256": {"$ref": "#/$defs/sha256"},
        "modelContractSha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "resolvedInitialization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "random"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind", "parentModelRef", "parentCheckpointSha256",
            "parentDataContractSha256", "dataContractSha256",
            "parentTargetContractSha256", "targetContractSha256",
            "parentObjectiveSha256", "objectiveSha256",
            "parentModelContractSha256", "modelContractSha256"
          ],
          "properties": {
            "kind": {"const": "publishedModel"},
            "parentModelRef": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "parentCheckpointSha256": {"$ref": "#/$defs/sha256"},
            "parentDataContractSha256": {"$ref": "#/$defs/sha256"},
            "dataContractSha256": {"$ref": "#/$defs/sha256"},
            "parentTargetContractSha256": {"$ref": "#/$defs/sha256"},
            "targetContractSha256": {"$ref": "#/$defs/sha256"},
            "parentObjectiveSha256": {"$ref": "#/$defs/sha256"},
            "objectiveSha256": {"$ref": "#/$defs/sha256"},
            "parentModelContractSha256": {"$ref": "#/$defs/sha256"},
            "modelContractSha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    }
  }
}
