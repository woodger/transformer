{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v2/cancel-result.schema.json",
  "title": "transformer.v2.job.cancel result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "requestId", "jobId", "state", "revision"],
  "properties": {
    "contract": {"const": "transformer-flight"},
    "version": {"const": 2},
    "requestId": {"type": "string", "format": "uuid"},
    "jobId": {"type": "string", "format": "uuid"},
    "state": {
      "enum": ["CANCELLING", "CANCELLED", "SUCCEEDED", "FAILED"]
    },
    "revision": {"type": "integer", "minimum": 1}
  }
}
