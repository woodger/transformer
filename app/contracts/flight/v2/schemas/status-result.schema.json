{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v2/status-result.schema.json",
  "title": "transformer.v2.job.status result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "requestId",
    "jobId",
    "operation",
    "state",
    "revision",
    "timestamps",
    "device",
    "committedInputs",
    "progress",
    "attempt",
    "recovery",
    "error",
    "results",
    "pollAfterMs"
  ],
  "properties": {
    "contract": {"const": "transformer-flight"},
    "version": {"const": 2},
    "requestId": {"type": "string", "format": "uuid"},
    "jobId": {"type": "string", "format": "uuid"},
    "operation": {"enum": ["fit", "predict"]},
    "state": {
      "enum": [
        "UPLOADING",
        "SEALED",
        "QUEUED",
        "RUNNING",
        "RETRYING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLING",
        "CANCELLED"
      ]
    },
    "revision": {"type": "integer", "minimum": 1},
    "timestamps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "createdAt",
        "updatedAt",
        "sealedAt",
        "queuedAt",
        "startedAt",
        "cancelRequestedAt",
        "finishedAt"
      ],
      "properties": {
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "sealedAt": {"type": ["string", "null"], "format": "date-time"},
        "queuedAt": {"type": ["string", "null"], "format": "date-time"},
        "startedAt": {"type": ["string", "null"], "format": "date-time"},
        "cancelRequestedAt": {"type": ["string", "null"], "format": "date-time"},
        "finishedAt": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "selected"],
      "properties": {
        "requested": {"enum": ["cpu", "cuda", "auto"]},
        "selected": {"type": ["string", "null"], "enum": ["cpu", "cuda", null]}
      }
    },
    "committedInputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "payloadId",
          "ordinal",
          "schemaId",
          "rows",
          "batches",
          "bytes",
          "sha256",
          "schemaFingerprint"
        ],
        "properties": {
          "payloadId": {"type": "string", "format": "uuid"},
          "ordinal": {"type": "integer", "minimum": 0, "maximum": 399},
          "schemaId": {
            "enum": ["inventory.sequence.fit.v1", "inventory.sequence.predict.v1"]
          },
          "rows": {"type": "integer", "minimum": 0},
          "batches": {"type": "integer", "minimum": 0},
          "bytes": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "schemaFingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "progress": {
      "type": "object",
      "additionalProperties": {
        "type": ["string", "number", "boolean", "null"]
      }
    },
    "attempt": {"type": "integer", "minimum": 0},
    "recovery": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "latestCheckpoint",
        "resumedFromGeneration",
        "retryCount",
        "lastRetryCode",
        "boundary"
      ],
      "properties": {
        "latestCheckpoint": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "generation",
            "completedEpochs",
            "globalStep",
            "trainingComplete"
          ],
          "properties": {
            "generation": {"type": "integer", "minimum": 1},
            "completedEpochs": {"type": "integer", "minimum": 1},
            "globalStep": {"type": "integer", "minimum": 0},
            "trainingComplete": {"type": "boolean"}
          }
        },
        "resumedFromGeneration": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "retryCount": {"type": "integer", "minimum": 0},
        "lastRetryCode": {
          "type": ["string", "null"],
          "enum": ["DEVICE_LOST", "EXECUTION_INTERRUPTED", null]
        },
        "boundary": {"const": "globalEpoch"}
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_ARGUMENT",
            "UNAUTHENTICATED",
            "PERMISSION_DENIED",
            "NOT_FOUND",
            "ALREADY_EXISTS",
            "FAILED_PRECONDITION",
            "RESOURCE_EXHAUSTED",
            "CANCELLED",
            "UNAVAILABLE",
            "INTERNAL",
            "DEVICE_UNAVAILABLE",
            "DEVICE_LOST",
            "EXECUTION_INTERRUPTED",
            "SUBPROCESS_FAILED",
            "SUBPROCESS_HUNG",
            "MALFORMED_OUTPUT",
            "CUDA_OUT_OF_MEMORY",
            "DISK_FULL",
            "RECOVERY_CHECKPOINT_UNAVAILABLE",
            "RECOVERY_CHECKPOINT_INCOMPATIBLE",
            "RECOVERY_INPUT_UNAVAILABLE"
          ]
        },
        "message": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outputs", "modelRef", "checkpoint"],
      "properties": {
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "descriptorPath", "rows", "bytes"],
            "properties": {
              "ordinal": {"type": "integer", "minimum": 0, "maximum": 399},
              "descriptorPath": {
                "type": "array",
                "prefixItems": [
                  {"const": "transformer"},
                  {"const": "v2"},
                  {"const": "jobs"},
                  {"type": "string", "format": "uuid"},
                  {"const": "outputs"},
                  {"type": "string", "pattern": "^(0|[1-9][0-9]?|[1-3][0-9]{2})$"}
                ],
                "items": false,
                "minItems": 6,
                "maxItems": 6
              },
              "rows": {"type": "integer", "minimum": 0},
              "bytes": {"type": "integer", "minimum": 0}
            }
          }
        },
        "modelRef": {
          "type": ["string", "null"],
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "checkpoint": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "format",
            "serviceVersion",
            "sha256",
            "bytes",
            "modelConfig",
            "trainConfig",
            "dataSchema",
            "checkpointSelection"
          ],
          "properties": {
            "format": {"const": "transformer-checkpoint-v2"},
            "serviceVersion": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "bytes": {"type": "integer", "minimum": 1},
            "generation": {"type": "integer", "minimum": 1},
            "modelConfig": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "seqLen",
                "hidden",
                "layers",
                "dropout",
                "nhead",
                "mode",
                "outDim",
                "featureDim"
              ],
              "properties": {
                "seqLen": {"type": "integer", "minimum": 1},
                "hidden": {"type": "integer", "minimum": 1},
                "layers": {"type": "integer", "minimum": 1},
                "dropout": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
                "nhead": {"type": "integer", "minimum": 1},
                "mode": {"enum": ["strict", "relaxed"]},
                "outDim": {"const": 6},
                "featureDim": {"type": "integer", "minimum": 1}
              }
            },
            "trainConfig": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "lr",
                "batchSize",
                "epochs",
                "patience",
                "lossStage",
                "lossSchedule",
                "stageSize",
                "useAmp",
                "weightDecay",
                "monitor",
                "monitorMinImprovement",
                "saveBestCheckpoint",
                "seed",
                "deterministic"
              ],
              "properties": {
                "lr": {"type": "number", "exclusiveMinimum": 0},
                "batchSize": {"type": "integer", "minimum": 1},
                "epochs": {"type": "integer", "minimum": 1},
                "patience": {"type": "integer", "minimum": 0},
                "lossStage": {"enum": [1, 2, 3, 4]},
                "lossSchedule": {"enum": ["none", "epoch", "step"]},
                "stageSize": {"type": "integer", "minimum": 1},
                "useAmp": {"type": "boolean"},
                "weightDecay": {"type": "number", "minimum": 0},
                "monitor": {"enum": ["loss", "ret_mae", "ret_mae_skill"]},
                "monitorMinImprovement": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 1
                },
                "saveBestCheckpoint": {"type": "boolean"},
                "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
                "deterministic": {"type": "boolean"}
              }
            },
            "dataSchema": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "schemaVersion",
                "tensorDtype",
                "source",
                "target",
                "featureDim",
                "modelInputFeatureDim",
                "contextMode",
                "normalization",
                "missing"
              ],
              "properties": {
                "schemaVersion": {"const": 1},
                "tensorDtype": {"const": "float32"},
                "source": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["column", "acceptedElementTypes", "width"],
                  "properties": {
                    "column": {"const": "src"},
                    "acceptedElementTypes": {
                      "type": "array",
                      "prefixItems": [{"const": "float32"}, {"const": "float64"}],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "width": {"type": "integer", "minimum": 1}
                  }
                },
                "target": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["column", "acceptedElementTypes", "width"],
                  "properties": {
                    "column": {"const": "tgt"},
                    "acceptedElementTypes": {
                      "type": "array",
                      "prefixItems": [{"const": "float32"}, {"const": "float64"}],
                      "items": false,
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "width": {"const": 6}
                  }
                },
                "featureDim": {"type": "integer", "minimum": 1},
                "modelInputFeatureDim": {"type": "integer", "minimum": 1},
                "contextMode": {"enum": ["strict", "relaxed"]},
                "normalization": {"const": null},
                "missing": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["nanFill", "flags"],
                  "properties": {
                    "nanFill": {"const": 0.0},
                    "flags": {"enum": ["per-feature", "none"]}
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {"contextMode": {"const": "relaxed"}},
                    "required": ["contextMode"]
                  },
                  "then": {
                    "properties": {
                      "missing": {"properties": {"flags": {"const": "per-feature"}}}
                    }
                  },
                  "else": {
                    "properties": {
                      "missing": {"properties": {"flags": {"const": "none"}}}
                    }
                  }
                }
              ]
            },
            "checkpointSelection": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "monitor",
                "monitorMinImprovement",
                "bestMonitor",
                "bestFrame",
                "bestEpoch",
                "baselinePassed",
                "source"
              ],
              "properties": {
                "monitor": {"enum": ["loss", "ret_mae", "ret_mae_skill"]},
                "monitorMinImprovement": {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 1
                },
                "bestMonitor": {"type": ["number", "null"]},
                "bestFrame": {"type": ["integer", "null"], "minimum": 0},
                "bestEpoch": {"type": ["integer", "null"], "minimum": 0},
                "baselinePassed": {"type": "boolean"},
                "source": {"enum": ["best_monitor", "current"]}
              }
            }
          }
        }
      }
    },
    "pollAfterMs": {"type": "integer", "minimum": 0}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {"enum": ["SUCCEEDED", "FAILED", "CANCELLED"]}
        },
        "required": ["state"]
      },
      "then": {"properties": {"pollAfterMs": {"const": 0}}},
      "else": {"properties": {"pollAfterMs": {"type": "integer", "minimum": 100}}}
    },
    {
      "if": {
        "properties": {"state": {"const": "FAILED"}},
        "required": ["state"]
      },
      "then": {"properties": {"error": {"type": "object"}}},
      "else": {"properties": {"error": {"const": null}}}
    },
    {
      "if": {
        "properties": {"state": {"const": "SUCCEEDED"}},
        "required": ["state"]
      },
      "else": {
        "properties": {
          "results": {
            "properties": {
              "outputs": {"maxItems": 0},
              "modelRef": {"const": null},
              "checkpoint": {"const": null}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {"const": "fit"},
          "state": {"const": "SUCCEEDED"}
        },
        "required": ["operation", "state"]
      },
      "then": {
        "properties": {
          "results": {
            "properties": {
              "outputs": {"maxItems": 0},
              "modelRef": {"type": "string", "minLength": 1},
              "checkpoint": {"type": "object"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {"const": "predict"},
          "state": {"const": "SUCCEEDED"}
        },
        "required": ["operation", "state"]
      },
      "then": {
        "properties": {
          "results": {
            "properties": {
              "modelRef": {"const": null},
              "checkpoint": {"const": null}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "QUEUED",
              "RUNNING",
              "RETRYING",
              "SUCCEEDED",
              "FAILED",
              "CANCELLING"
            ]
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "device": {"properties": {"selected": {"enum": ["cpu", "cuda"]}}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "RUNNING",
              "RETRYING",
              "SUCCEEDED",
              "FAILED",
              "CANCELLING"
            ]
          }
        },
        "required": ["state"]
      },
      "then": {
        "properties": {
          "attempt": {"type": "integer", "minimum": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"operation": {"const": "fit"}},
        "required": ["operation"]
      },
      "then": {
        "properties": {"recovery": {"type": "object"}}
      },
      "else": {
        "properties": {"recovery": {"const": null}}
      }
    },
    {
      "if": {
        "properties": {
          "device": {
            "properties": {"requested": {"const": "cpu"}},
            "required": ["requested"]
          }
        },
        "required": ["device"]
      },
      "then": {
        "properties": {
          "device": {"properties": {"selected": {"enum": ["cpu", null]}}}
        }
      }
    },
    {
      "if": {
        "properties": {
          "device": {
            "properties": {"requested": {"const": "cuda"}},
            "required": ["requested"]
          }
        },
        "required": ["device"]
      },
      "then": {
        "properties": {
          "device": {"properties": {"selected": {"enum": ["cuda", null]}}}
        }
      }
    }
  ]
}
