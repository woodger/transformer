{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v3/model-describe.schema.json",
  "title": "transformer.v3.model.describe request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "requestId"],
  "properties": {
    "contract": {"const": "transformer-flight"},
    "version": {"const": 3},
    "requestId": {"$ref": "common.schema.json#/$defs/uuid"},
    "modelRef": {"$ref": "common.schema.json#/$defs/label"},
    "modelAlias": {"$ref": "common.schema.json#/$defs/label"}
  },
  "oneOf": [{"required": ["modelRef"]}, {"required": ["modelAlias"]}]
}
