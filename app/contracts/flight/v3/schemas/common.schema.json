{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v3/common.schema.json",
  "title": "Transformer Flight v3 common definitions",
  "$defs": {
    "uuid": {"type": "string", "format": "uuid"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "fencingToken": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "predictionColumn": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
    },
    "inputState": {"enum": ["OPEN", "CLOSED", "ABORTED"]},
    "executionState": {
      "enum": [
        "WAITING_INPUT", "QUEUED", "RUNNING", "RETRYING",
        "CANCELLING", "SUCCEEDED", "FAILED", "CANCELLED"
      ]
    },
    "dataContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "dataContractSha256", "seqLen", "featureDim",
        "targetSchemaId"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/label"},
        "version": {"type": "integer", "minimum": 1},
        "dataContractSha256": {"$ref": "#/$defs/sha256"},
        "seqLen": {"type": "integer", "minimum": 1},
        "featureDim": {"type": "integer", "minimum": 1},
        "targetSchemaId": {"$ref": "#/$defs/label"}
      }
    },
    "modelConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seqLen", "hidden", "layers", "dropout", "nhead", "mode",
        "outDim", "featureDim"
      ],
      "properties": {
        "seqLen": {"type": "integer", "minimum": 1},
        "hidden": {"type": "integer", "minimum": 1},
        "layers": {"type": "integer", "minimum": 1},
        "dropout": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "nhead": {"type": "integer", "minimum": 1},
        "mode": {"enum": ["strict", "relaxed"]},
        "outDim": {"const": 6},
        "featureDim": {"type": "integer", "minimum": 1}
      }
    },
    "trainingConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lr", "batchSize", "epochs", "patience", "lossStage",
        "lossSchedule", "stageSize", "useAmp", "weightDecay", "monitor",
        "monitorMinImprovement", "saveBestCheckpoint", "seed",
        "deterministic"
      ],
      "properties": {
        "lr": {"type": "number", "exclusiveMinimum": 0},
        "batchSize": {"type": "integer", "minimum": 1},
        "epochs": {"type": "integer", "minimum": 1},
        "patience": {"type": "integer", "minimum": 0},
        "lossStage": {"enum": [1, 2, 3, 4]},
        "lossSchedule": {"enum": ["none", "epoch", "step"]},
        "stageSize": {"type": "integer", "minimum": 1},
        "useAmp": {"type": "boolean"},
        "weightDecay": {"type": "number", "minimum": 0},
        "monitor": {"enum": ["loss", "ret_mae", "ret_mae_skill"]},
        "monitorMinImprovement": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        },
        "saveBestCheckpoint": {"type": "boolean"},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "deterministic": {"type": "boolean"}
      }
    },
    "checkpointSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monitor", "monitorMinImprovement", "bestMonitor", "bestFrame",
        "bestEpoch", "baselinePassed", "source"
      ],
      "properties": {
        "monitor": {"enum": ["loss", "ret_mae", "ret_mae_skill"]},
        "monitorMinImprovement": {
          "type": "number", "minimum": 0, "exclusiveMaximum": 1
        },
        "bestMonitor": {"type": ["number", "null"]},
        "bestFrame": {"type": ["integer", "null"], "minimum": 0},
        "bestEpoch": {"type": ["integer", "null"], "minimum": 0},
        "baselinePassed": {"type": "boolean"},
        "source": {"enum": ["best_monitor", "current"]}
      }
    },
    "checkpointSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format", "serviceVersion", "sha256", "bytes", "generation",
        "modelConfig", "trainingConfig", "dataContract",
        "checkpointSelection"
      ],
      "properties": {
        "format": {"const": "transformer-checkpoint-v2"},
        "serviceVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "generation": {"type": "integer", "minimum": 1},
        "modelConfig": {"$ref": "#/$defs/modelConfig"},
        "trainingConfig": {"$ref": "#/$defs/trainingConfig"},
        "dataContract": {"$ref": "#/$defs/dataContract"},
        "checkpointSelection": {"$ref": "#/$defs/checkpointSelection"}
      }
    },
    "inputReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payloadId", "ordinal", "commitRevision", "schemaId",
        "dataContractSha256", "rows", "batches", "bytes", "sha256",
        "schemaFingerprint"
      ],
      "properties": {
        "payloadId": {"$ref": "#/$defs/uuid"},
        "ordinal": {"type": "integer", "minimum": 0},
        "commitRevision": {"type": "integer", "minimum": 1},
        "schemaId": {
          "enum": ["inventory.sequence.fit.v2", "inventory.sequence.predict.v2"]
        },
        "dataContractSha256": {"$ref": "#/$defs/sha256"},
        "rows": {"type": "integer", "minimum": 0},
        "batches": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schemaFingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "outputReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "descriptorPath", "rows", "bytes", "sha256"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "descriptorPath": {
          "type": "array",
          "prefixItems": [
            {"const": "transformer"},
            {"const": "v3"},
            {"const": "jobs"},
            {"$ref": "#/$defs/uuid"},
            {"const": "outputs"},
            {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        },
        "rows": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
