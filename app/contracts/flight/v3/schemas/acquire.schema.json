{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v3/acquire.schema.json",
  "title": "transformer.v3.job.acquire request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "version", "requestId", "idempotencyKey", "jobId",
    "previousClientExecutionId", "expectedFencingToken", "clientExecutionId"
  ],
  "properties": {
    "contract": {"const": "transformer-flight"},
    "version": {"const": 3},
    "requestId": {"$ref": "common.schema.json#/$defs/uuid"},
    "idempotencyKey": {"$ref": "common.schema.json#/$defs/idempotencyKey"},
    "jobId": {"$ref": "common.schema.json#/$defs/uuid"},
    "previousClientExecutionId": {"$ref": "common.schema.json#/$defs/uuid"},
    "expectedFencingToken": {"$ref": "common.schema.json#/$defs/fencingToken"},
    "clientExecutionId": {"$ref": "common.schema.json#/$defs/uuid"}
  }
}
