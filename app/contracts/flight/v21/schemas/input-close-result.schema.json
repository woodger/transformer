{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v21/input-close-result.schema.json",
  "title": "transformer.v21.job.input.close result",
  "type": "object", "additionalProperties": false,
  "required": ["requestId", "jobId", "revision", "input", "execution"],
  "properties": {
    "requestId": {"$ref": "common.schema.json#/$defs/uuid"},
    "jobId": {"$ref": "common.schema.json#/$defs/uuid"},
    "revision": {"type": "integer", "minimum": 2},
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "payloadCount", "logicalRows", "manifestSha256"],
      "properties": {
        "state": {"const": "CLOSED"},
        "payloadCount": {"type": "integer", "minimum": 0},
        "logicalRows": {"type": "integer", "minimum": 0},
        "manifestSha256": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    },
    "execution": {"type": "object", "additionalProperties": false, "required": ["state"], "properties": {"state": {"$ref": "common.schema.json#/$defs/executionState"}}}
  }
}
