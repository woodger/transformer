{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v15/predict-create-result.schema.json",
  "title": "transformer.v15.predict.create result",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "jobId", "mutationLease", "input", "execution", "device", "modelRef", "predictionDefinition", "upload", "limits"],
  "properties": {
    "requestId": {"$ref": "common.schema.json#/$defs/uuid"},
    "jobId": {"$ref": "common.schema.json#/$defs/uuid"},
    "mutationLease": {"$ref": "common.schema.json#/$defs/mutationLease"},
    "input": {"$ref": "fit-create-result.schema.json#/$defs/openInput"},
    "execution": {"$ref": "fit-create-result.schema.json#/$defs/waitingExecution"},
    "device": {"$ref": "fit-create-result.schema.json#/$defs/requestedDevice"},
    "modelRef": {"$ref": "common.schema.json#/$defs/modelRef"},
    "predictionDefinition": {
      "type": "object", "additionalProperties": false,
      "required": ["seqLen", "outputWidth", "targets"],
      "properties": {
        "seqLen": {"type": "integer", "minimum": 1},
        "outputWidth": {"type": "integer", "minimum": 1},
        "targets": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["identity", "publicPredictionTransformation"],
            "properties": {
              "identity": {"type": "string"},
              "publicPredictionTransformation": {"enum": ["Identity", "Tanh", "Sigmoid"]}
            }
          }
        }
      }
    },
    "upload": {"$ref": "fit-create-result.schema.json#/$defs/upload"},
    "limits": {"$ref": "fit-create-result.schema.json#/$defs/limits"}
  }
}
