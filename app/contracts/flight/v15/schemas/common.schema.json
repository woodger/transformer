{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v15/common.schema.json",
  "title": "Transformer Flight v15 common definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "modelRef": {
      "type": "string",
      "pattern": "^mdl_[0-9a-f]{32}$"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "mutationLease": {
      "type": "string",
      "minLength": 32,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "inputState": {
      "enum": ["OPEN", "CLOSED", "ABORTED"]
    },
    "executionState": {
      "enum": [
        "WAITING_INPUT",
        "QUEUED",
        "RUNNING",
        "RETRYING",
        "CANCELLING",
        "SUCCEEDED",
        "FAILED",
        "CANCELLED"
      ]
    },
    "tensorGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seqLen", "featureDim"],
      "properties": {
        "seqLen": {"type": "integer", "minimum": 1},
        "featureDim": {"type": "integer", "minimum": 1}
      }
    },
    "inputLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["featureBlocks"],
      "properties": {
        "featureBlocks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["windowRows", "nativeRowWidth"],
            "properties": {
              "windowRows": {"type": "integer", "minimum": 1},
              "nativeRowWidth": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "dataBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataContractSha256", "tensorGeometry", "inputLayout"],
      "properties": {
        "dataContractSha256": {"$ref": "#/$defs/sha256"},
        "tensorGeometry": {"$ref": "#/$defs/tensorGeometry"},
        "inputLayout": {"$ref": "#/$defs/inputLayout"}
      }
    },
    "requestedInitialization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": {"source": {"const": "random"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "modelRef"],
          "properties": {
            "source": {"const": "publishedModel"},
            "modelRef": {"$ref": "#/$defs/modelRef"}
          }
        }
      ]
    },
    "resolvedInitialization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["source"],
          "properties": {"source": {"const": "random"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "parentModelRef",
            "parentCheckpointSha256",
            "parentDataContractSha256",
            "dataContractSha256",
            "parentTargetContractSha256",
            "targetContractSha256",
            "parentObjectiveSha256",
            "objectiveSha256",
            "parentModelDefinitionSha256",
            "modelDefinitionSha256"
          ],
          "properties": {
            "source": {"const": "publishedModel"},
            "parentModelRef": {"$ref": "#/$defs/modelRef"},
            "parentCheckpointSha256": {"$ref": "#/$defs/sha256"},
            "parentDataContractSha256": {"$ref": "#/$defs/sha256"},
            "dataContractSha256": {"$ref": "#/$defs/sha256"},
            "parentTargetContractSha256": {"$ref": "#/$defs/sha256"},
            "targetContractSha256": {"$ref": "#/$defs/sha256"},
            "parentObjectiveSha256": {"$ref": "#/$defs/sha256"},
            "objectiveSha256": {"$ref": "#/$defs/sha256"},
            "parentModelDefinitionSha256": {"$ref": "#/$defs/sha256"},
            "modelDefinitionSha256": {"$ref": "#/$defs/sha256"}
          }
        }
      ]
    },
    "selectionConfig": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["minDelta", "patience"],
          "properties": {
            "minDelta": {"type": "number", "minimum": 0},
            "patience": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "trainingConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learningRate",
        "batchSize",
        "epochs",
        "mixedPrecision",
        "weightDecay",
        "selection",
        "seed",
        "deterministic"
      ],
      "properties": {
        "learningRate": {"type": "number", "exclusiveMinimum": 0},
        "batchSize": {"type": "integer", "minimum": 1},
        "epochs": {"type": "integer", "minimum": 1},
        "mixedPrecision": {"type": "boolean"},
        "weightDecay": {"type": "number", "minimum": 0},
        "selection": {"$ref": "#/$defs/selectionConfig"},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "deterministic": {"type": "boolean"}
      }
    },
    "diagnosticsConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gradientInteractions"],
      "properties": {
        "gradientInteractions": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["everySteps", "maxBatches"],
              "properties": {
                "everySteps": {"type": "integer", "minimum": 1},
                "maxBatches": {"type": "integer", "minimum": 1}
              }
            }
          ]
        }
      }
    },
    "inputReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payloadId", "ordinal", "commitRevision", "chunks", "logicalRows",
        "nativeRows", "firstRangeOrdinal", "firstExampleOffset",
        "lastRangeOrdinal", "nextExampleOffset", "batches", "bytes", "sha256",
        "schemaFingerprint"
      ],
      "properties": {
        "payloadId": {"$ref": "#/$defs/uuid"},
        "ordinal": {"type": "integer", "minimum": 0},
        "commitRevision": {"type": "integer", "minimum": 1},
        "chunks": {"type": "integer", "minimum": 0},
        "logicalRows": {"type": "integer", "minimum": 0},
        "nativeRows": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "firstRangeOrdinal": {"type": ["integer", "null"], "minimum": 0},
        "firstExampleOffset": {"type": ["integer", "null"], "minimum": 0},
        "lastRangeOrdinal": {"type": ["integer", "null"], "minimum": 0},
        "nextExampleOffset": {"type": ["integer", "null"], "minimum": 0},
        "batches": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schemaFingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "outputReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "descriptorPath", "logicalRows", "bytes", "sha256"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "descriptorPath": {"type": "array", "items": {"type": "string"}},
        "logicalRows": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
