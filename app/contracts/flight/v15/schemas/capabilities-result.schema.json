{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v15/capabilities-result.schema.json",
  "title": "transformer.v15.capabilities result",
  "type": "object", "additionalProperties": false,
  "required": ["requestId", "devices", "limits", "queries"],
  "properties": {
    "requestId": {"$ref": "common.schema.json#/$defs/uuid"},
    "devices": {
      "type": "object", "additionalProperties": false, "required": ["cpu", "gpu"],
      "properties": {
        "cpu": {"type": "object", "additionalProperties": false, "required": ["available"], "properties": {"available": {"const": true}}},
        "gpu": {"type": "object", "additionalProperties": false, "required": ["available"], "properties": {"available": {"type": "boolean"}}}
      }
    },
    "limits": {"$ref": "fit-create-result.schema.json#/$defs/limits"},
    "queries": {"type": "object", "additionalProperties": false, "required": ["modelCatalog", "trainingTelemetry"], "properties": {"modelCatalog": {"type": "boolean"}, "trainingTelemetry": {"type": "boolean"}}}
  }
}
