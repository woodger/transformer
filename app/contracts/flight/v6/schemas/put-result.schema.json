{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v6/put-result.schema.json",
  "title": "Transformer Flight v6 DoPut result metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "version", "jobId", "payloadId", "ordinal", "status",
    "rows", "batches", "bytes", "sha256", "schemaFingerprint",
    "inputRevision", "nextInputOrdinal", "queued"
  ],
  "properties": {
    "contract": {"const": "transformer-flight"},
    "version": {"const": 6},
    "jobId": {"$ref": "common.schema.json#/$defs/uuid"},
    "payloadId": {"$ref": "common.schema.json#/$defs/uuid"},
    "ordinal": {"type": "integer", "minimum": 0, "maximum": 99999},
    "status": {"const": "committed"},
    "rows": {"type": "integer", "minimum": 0},
    "batches": {"type": "integer", "minimum": 0},
    "bytes": {"type": "integer", "minimum": 0},
    "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "schemaFingerprint": {"$ref": "common.schema.json#/$defs/sha256"},
    "inputRevision": {"type": "integer", "minimum": 1},
    "nextInputOrdinal": {"type": "integer", "minimum": 0, "maximum": 100000},
    "queued": {"type": "boolean"}
  }
}
