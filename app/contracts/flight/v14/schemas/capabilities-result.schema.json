{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v14/capabilities-result.schema.json",
  "title": "transformer.v14.capabilities result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "requestId",
    "protocolVersions",
    "workerProtocolVersion",
    "checkpointFormat",
    "recoveryFormat",
    "metricsFormats",
    "service",
    "schemaIds",
    "sourceEncodings",
    "semantic",
    "modelCatalog",
    "trainingTelemetry",
    "limits",
    "devices",
    "queue",
    "supportedOperations",
    "fitInitializations",
    "features"
  ],
  "properties": {
    "contract": {
      "const": "transformer-flight"
    },
    "version": {
      "const": 14
    },
    "requestId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "protocolVersions": {
      "const": [
        14
      ]
    },
    "workerProtocolVersion": {
      "const": 13
    },
    "checkpointFormat": {
      "const": "transformer-checkpoint-v7"
    },
    "recoveryFormat": {
      "const": "transformer-recovery-v7"
    },
    "metricsFormats": {
      "const": [
        "transformer.fit-run-summary.v6",
        "transformer.training-metrics.v6"
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "pyarrowVersion",
        "torchVersion"
      ],
      "properties": {
        "name": {
          "const": "transformer-flight"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "pyarrowVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "torchVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    "schemaIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fitInput",
        "predictInput",
        "predictionOutput"
      ],
      "properties": {
        "fitInput": {
          "const": "transformer.indexed-feature-blocks.fit.v1"
        },
        "predictInput": {
          "const": "transformer.indexed-feature-blocks.predict.v1"
        },
        "predictionOutput": {
          "const": "transformer.prediction.target-aligned.v3"
        }
      }
    },
    "sourceEncodings": {
      "const": [
        "indexedFeatureBlocks"
      ]
    },
    "semantic": {
      "$ref": "https://transformer.local/contracts/semantic/v2/language-capabilities.schema.json"
    },
    "modelCatalog": {
      "$ref": "https://transformer.local/contracts/model-catalog/v2/capabilities.schema.json"
    },
    "trainingTelemetry": {
      "$ref": "https://transformer.local/contracts/training-telemetry/v2/capabilities.schema.json"
    },
    "limits": {
      "$ref": "create-result.schema.json#/$defs/limits"
    },
    "devices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu",
        "gpu"
      ],
      "properties": {
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available"
          ],
          "properties": {
            "available": {
              "const": true
            }
          }
        },
        "gpu": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "available",
            "deviceCount",
            "quarantinedCount"
          ],
          "properties": {
            "available": {
              "type": "boolean"
            },
            "deviceCount": {
              "type": "integer",
              "minimum": 0
            },
            "quarantinedCount": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpuCapacity",
        "gpuCapacity",
        "singleInstance"
      ],
      "properties": {
        "cpuCapacity": {
          "type": "integer",
          "minimum": 1
        },
        "gpuCapacity": {
          "type": "integer",
          "minimum": 0
        },
        "singleInstance": {
          "const": true
        }
      }
    },
    "supportedOperations": {
      "const": [
        "fit",
        "predict"
      ]
    },
    "fitInitializations": {
      "const": [
        "publishedModel",
        "random"
      ]
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doExchange",
        "pollFlightInfo",
        "durableStreamingInput",
        "clientGeneratedJobId",
        "crossSystemFencing",
        "revisionPagination",
        "resumableFit",
        "recoveryBoundary",
        "deviceAwareGpu",
        "structuredErrorDetails"
      ],
      "properties": {
        "doExchange": {
          "const": false
        },
        "pollFlightInfo": {
          "const": false
        },
        "durableStreamingInput": {
          "const": true
        },
        "clientGeneratedJobId": {
          "const": true
        },
        "crossSystemFencing": {
          "const": true
        },
        "revisionPagination": {
          "const": true
        },
        "resumableFit": {
          "const": true
        },
        "recoveryBoundary": {
          "const": "globalEpoch"
        },
        "deviceAwareGpu": {
          "const": true
        },
        "structuredErrorDetails": {
          "const": true
        }
      }
    }
  }
}
