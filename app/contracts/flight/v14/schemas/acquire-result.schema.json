{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v14/acquire-result.schema.json",
  "title": "transformer.v14.job.acquire result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "requestId",
    "jobId",
    "revision",
    "ownership"
  ],
  "properties": {
    "contract": {
      "const": "transformer-flight"
    },
    "version": {
      "const": 14
    },
    "requestId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "jobId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 2
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clientExecutionId",
        "fencingToken"
      ],
      "properties": {
        "clientExecutionId": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "fencingToken": {
          "$ref": "common.schema.json#/$defs/fencingToken"
        }
      }
    }
  }
}
