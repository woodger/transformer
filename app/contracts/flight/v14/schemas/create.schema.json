{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v14/create.schema.json",
  "title": "transformer.v14.job.create request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "requestId",
    "idempotencyKey",
    "jobId",
    "clientExecutionId",
    "operation",
    "device",
    "sourceEncoding",
    "dataContract",
    "modelContract"
  ],
  "properties": {
    "contract": {
      "const": "transformer-flight"
    },
    "version": {
      "const": 14
    },
    "requestId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "idempotencyKey": {
      "$ref": "common.schema.json#/$defs/idempotencyKey"
    },
    "jobId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "clientExecutionId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "operation": {
      "enum": [
        "fit",
        "predict"
      ]
    },
    "device": {
      "enum": [
        "cpu",
        "gpu",
        "auto"
      ]
    },
    "modelLabel": {
      "$ref": "common.schema.json#/$defs/label"
    },
    "modelRef": {
      "$ref": "common.schema.json#/$defs/label"
    },
    "modelAlias": {
      "$ref": "common.schema.json#/$defs/label"
    },
    "predictionColumn": {
      "$ref": "common.schema.json#/$defs/predictionColumn"
    },
    "initialization": {
      "$ref": "common.schema.json#/$defs/requestedInitialization"
    },
    "trainingConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lr": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "batchSize": {
          "type": "integer",
          "minimum": 1
        },
        "epochs": {
          "type": "integer",
          "minimum": 1
        },
        "useAmp": {
          "type": "boolean"
        },
        "weightDecay": {
          "type": "number",
          "minimum": 0
        },
        "selection": {
          "$ref": "common.schema.json#/$defs/selectionConfig"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "deterministic": {
          "type": "boolean"
        }
      }
    },
    "diagnostics": {
      "$ref": "common.schema.json#/$defs/diagnosticsConfig"
    },
    "sourceEncoding": {
      "$ref": "common.schema.json#/$defs/sourceEncoding"
    },
    "dataContract": {
      "$ref": "common.schema.json#/$defs/dataContract"
    },
    "modelContract": {
      "$ref": "common.schema.json#/$defs/modelContract"
    }
  },
  "oneOf": [
    {
      "properties": {
        "operation": {
          "const": "fit"
        }
      },
      "required": [
        "modelLabel",
        "initialization"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "modelRef"
            ]
          },
          {
            "required": [
              "modelAlias"
            ]
          },
          {
            "required": [
              "predictionColumn"
            ]
          }
        ]
      }
    },
    {
      "properties": {
        "operation": {
          "const": "predict"
        }
      },
      "oneOf": [
        {
          "required": [
            "modelRef"
          ]
        },
        {
          "required": [
            "modelAlias"
          ]
        }
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "modelLabel"
            ]
          },
          {
            "required": [
              "initialization"
            ]
          },
          {
            "required": [
              "trainingConfig"
            ]
          },
          {
            "required": [
              "diagnostics"
            ]
          }
        ]
      }
    }
  ]
}
