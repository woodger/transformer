{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v23/error-detail.schema.json",
  "title": "Transformer Flight v23 application error detail",
  "anyOf": [
    {
      "$ref": "https://transformer.local/contracts/semantic/v6/error-detail.schema.json"
    },
    {
      "$ref": "https://transformer.local/contracts/model-catalog/v8/error-detail.schema.json"
    },
    {
      "$ref": "https://transformer.local/contracts/model-topology/v4/error-detail.schema.json"
    },
    {
      "$ref": "https://transformer.local/contracts/training-telemetry/v4/error-detail.schema.json"
    },
    {
      "$ref": "https://transformer.local/contracts/target-head-diagnostics/v5/error-detail.schema.json"
    },
    {
      "$ref": "#/$defs/invalidDiagnosticsConfiguration"
    }
  ],
  "$defs": {
    "pointer": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
    },
    "invalidDiagnosticsConfiguration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "reason",
        "path",
        "message"
      ],
      "properties": {
        "code": {
          "const": "INVALID_ARGUMENT"
        },
        "reason": {
          "const": "INVALID_DIAGNOSTICS_CONFIGURATION"
        },
        "path": {
          "$ref": "#/$defs/pointer"
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    }
  }
}
