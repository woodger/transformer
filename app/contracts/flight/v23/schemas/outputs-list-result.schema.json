{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v23/outputs-list-result.schema.json",
  "title": "transformer.v23.job.outputs.list result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "jobId",
    "cursor",
    "items",
    "nextCursor",
    "hasMore"
  ],
  "properties": {
    "requestId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "jobId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "cursor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "common.schema.json#/$defs/outputReceipt"
      }
    },
    "nextCursor": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "hasMore": {
      "type": "boolean"
    }
  }
}
