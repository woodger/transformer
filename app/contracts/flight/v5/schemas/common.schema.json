{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v5/common.schema.json",
  "title": "Transformer Flight v5 common definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "fencingToken": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "predictionColumn": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
    },
    "inputState": {"enum": ["OPEN", "CLOSED", "ABORTED"]},
    "executionState": {
      "enum": [
        "WAITING_INPUT", "QUEUED", "RUNNING", "RETRYING",
        "CANCELLING", "SUCCEEDED", "FAILED", "CANCELLED"
      ]
    },
    "dataContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "profile", "dataContractSha256", "seqLen",
        "featureDim", "targetSchemaId"
      ],
      "properties": {
        "id": {"const": "inventory.learning-dataset"},
        "version": {"const": 2},
        "profile": {"$ref": "#/$defs/label"},
        "dataContractSha256": {"$ref": "#/$defs/sha256"},
        "seqLen": {"type": "integer", "minimum": 1},
        "featureDim": {"type": "integer", "minimum": 1},
        "targetSchemaId": {"const": "inventory.target.v2"}
      }
    },
    "mlContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetSchemaId", "predictionSchemaId", "objectiveId",
        "objectiveConfigSha256", "checkpointFormat", "targetWidth",
        "predictionSpace"
      ],
      "properties": {
        "targetSchemaId": {"const": "inventory.target.v2"},
        "predictionSchemaId": {
          "const": "transformer.prediction.target-aligned.v2"
        },
        "objectiveId": {"const": "transformer.objective.target-aligned.v2"},
        "objectiveConfigSha256": {"$ref": "#/$defs/sha256"},
        "checkpointFormat": {"const": "transformer-checkpoint-v4"},
        "targetWidth": {"const": 6},
        "predictionSpace": {"const": "target"}
      }
    },
    "advertisedMlContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetSchemaId", "predictionSchemaId", "objectiveId",
        "checkpointFormat", "targetWidth", "predictionSpace",
        "objectiveConfigSchemaVersion"
      ],
      "properties": {
        "targetSchemaId": {"const": "inventory.target.v2"},
        "predictionSchemaId": {
          "const": "transformer.prediction.target-aligned.v2"
        },
        "objectiveId": {"const": "transformer.objective.target-aligned.v2"},
        "checkpointFormat": {"const": "transformer-checkpoint-v4"},
        "targetWidth": {"const": 6},
        "predictionSpace": {"const": "target"},
        "objectiveConfigSchemaVersion": {"const": 2}
      }
    },
    "modelConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seqLen", "hidden", "layers", "dropout", "nhead", "mode",
        "outDim", "featureDim"
      ],
      "properties": {
        "seqLen": {"type": "integer", "minimum": 1},
        "hidden": {"type": "integer", "minimum": 1},
        "layers": {"type": "integer", "minimum": 1},
        "dropout": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "nhead": {"type": "integer", "minimum": 1},
        "mode": {"enum": ["strict", "relaxed"]},
        "outDim": {"const": 6},
        "featureDim": {"type": "integer", "minimum": 1}
      }
    },
    "selectionConfig": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["minDelta", "patience"],
          "properties": {
            "minDelta": {"type": "number", "minimum": 0},
            "patience": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "trainingConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lr", "batchSize", "epochs", "lossStage", "lossSchedule",
        "stageSize", "useAmp", "weightDecay", "directLossWeights",
        "selection", "seed", "deterministic"
      ],
      "properties": {
        "lr": {"type": "number", "exclusiveMinimum": 0},
        "batchSize": {"type": "integer", "minimum": 1},
        "epochs": {"type": "integer", "minimum": 1},
        "lossStage": {"const": 4},
        "lossSchedule": {"enum": ["none", "epoch", "step"]},
        "stageSize": {"type": "integer", "minimum": 1},
        "useAmp": {"type": "boolean"},
        "weightDecay": {"type": "number", "minimum": 0},
        "directLossWeights": {
          "type": "array",
          "items": {"type": "number", "exclusiveMinimum": 0},
          "minItems": 6,
          "maxItems": 6
        },
        "selection": {"$ref": "#/$defs/selectionConfig"},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "deterministic": {"type": "boolean"}
      }
    },
    "objectiveConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "objectiveId", "directLosses", "auxiliaryLosses",
        "stagePolicy", "selection"
      ],
      "properties": {
        "schemaVersion": {"const": 2},
        "objectiveId": {"const": "transformer.objective.target-aligned.v2"},
        "directLosses": {"type": "array", "minItems": 6, "maxItems": 6},
        "auxiliaryLosses": {"type": "array"},
        "stagePolicy": {"type": "object"},
        "selection": {"type": "object"}
      }
    },
    "checkpointSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled", "objectiveConfigSha256", "bestSelectionScore",
        "bestFrame", "bestEpoch", "source"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "objectiveConfigSha256": {"$ref": "#/$defs/sha256"},
        "bestSelectionScore": {"type": ["number", "null"]},
        "bestFrame": {"type": ["integer", "null"], "minimum": 0},
        "bestEpoch": {"type": ["integer", "null"], "minimum": 1},
        "source": {
          "enum": ["best_selection_score", "last_maximum_stage"]
        }
      }
    },
    "checkpointSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format", "serviceVersion", "sha256", "bytes", "generation",
        "modelConfig", "trainingConfig", "dataContract", "mlContract",
        "checkpointSelection"
      ],
      "properties": {
        "format": {"const": "transformer-checkpoint-v4"},
        "serviceVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "generation": {"type": "integer", "minimum": 1},
        "modelConfig": {"$ref": "#/$defs/modelConfig"},
        "trainingConfig": {"$ref": "#/$defs/trainingConfig"},
        "dataContract": {"$ref": "#/$defs/dataContract"},
        "mlContract": {"$ref": "#/$defs/mlContract"},
        "checkpointSelection": {"$ref": "#/$defs/checkpointSelection"}
      }
    },
    "inputReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payloadId", "ordinal", "commitRevision", "schemaId",
        "dataContractSha256", "rows", "batches", "bytes", "sha256",
        "schemaFingerprint"
      ],
      "properties": {
        "payloadId": {"$ref": "#/$defs/uuid"},
        "ordinal": {"type": "integer", "minimum": 0},
        "commitRevision": {"type": "integer", "minimum": 1},
        "schemaId": {
          "enum": ["inventory.sequence.fit.v2", "inventory.sequence.predict.v2"]
        },
        "dataContractSha256": {"$ref": "#/$defs/sha256"},
        "rows": {"type": "integer", "minimum": 0},
        "batches": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schemaFingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "outputReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "descriptorPath", "rows", "bytes", "sha256"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "descriptorPath": {
          "type": "array",
          "prefixItems": [
            {"const": "transformer"},
            {"const": "v5"},
            {"const": "jobs"},
            {"$ref": "#/$defs/uuid"},
            {"const": "outputs"},
            {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        },
        "rows": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
