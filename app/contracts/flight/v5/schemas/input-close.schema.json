{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v5/input-close.schema.json",
  "title": "transformer.v5.job.input.close request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "version", "requestId", "idempotencyKey", "jobId",
    "clientExecutionId", "fencingToken", "payloadCount", "totalRows",
    "totalBytes", "manifestSha256"
  ],
  "properties": {
    "contract": {"const": "transformer-flight"},
    "version": {"const": 5},
    "requestId": {"$ref": "common.schema.json#/$defs/uuid"},
    "idempotencyKey": {"$ref": "common.schema.json#/$defs/idempotencyKey"},
    "jobId": {"$ref": "common.schema.json#/$defs/uuid"},
    "clientExecutionId": {"$ref": "common.schema.json#/$defs/uuid"},
    "fencingToken": {"$ref": "common.schema.json#/$defs/fencingToken"},
    "payloadCount": {"type": "integer", "minimum": 0, "maximum": 100000},
    "totalRows": {"type": "integer", "minimum": 0},
    "totalBytes": {"type": "integer", "minimum": 0},
    "manifestSha256": {"$ref": "common.schema.json#/$defs/sha256"}
  }
}
