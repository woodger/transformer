{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v12/status-result.schema.json",
  "title": "transformer.v12.job.status result",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "requestId", "jobId", "operation", "revision", "input", "execution", "ownership", "timestamps", "device", "sourceEncoding", "dataContract", "modelContract", "semanticDigests", "jobConfigSha256", "initialization", "resolvedModelRef", "predictionColumn", "progress", "recovery", "error", "results", "pollAfterMs"],
  "properties": {
    "contract": {"const": "transformer-flight"}, "version": {"const": 12}, "requestId": {"$ref": "common.schema.json#/$defs/uuid"}, "jobId": {"$ref": "common.schema.json#/$defs/uuid"}, "operation": {"enum": ["fit", "predict"]}, "revision": {"type": "integer", "minimum": 1},
    "input": {"type": "object", "additionalProperties": false, "required": ["state", "revision", "nextOrdinal", "payloadCount", "totalChunks", "totalLogicalRows", "totalNativeRows", "rangeCount", "totalBytes", "manifestSha256"], "properties": {"state": {"$ref": "common.schema.json#/$defs/inputState"}, "revision": {"type": "integer", "minimum": 0}, "nextOrdinal": {"type": "integer", "minimum": 0}, "payloadCount": {"type": "integer", "minimum": 0}, "totalChunks": {"type": "integer", "minimum": 0}, "totalLogicalRows": {"type": "integer", "minimum": 0}, "totalNativeRows": {"$ref": "common.schema.json#/$defs/nativeRows"}, "rangeCount": {"type": ["integer", "null"], "minimum": 0}, "totalBytes": {"type": "integer", "minimum": 0}, "manifestSha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["state", "attempt"], "properties": {"state": {"$ref": "common.schema.json#/$defs/executionState"}, "attempt": {"type": "integer", "minimum": 0}}},
    "ownership": {"type": "object", "additionalProperties": false, "required": ["clientExecutionId", "fencingToken"], "properties": {"clientExecutionId": {"$ref": "common.schema.json#/$defs/uuid"}, "fencingToken": {"$ref": "common.schema.json#/$defs/fencingToken"}}},
    "timestamps": {"type": "object", "additionalProperties": false, "required": ["createdAt", "updatedAt", "inputClosedAt", "queuedAt", "startedAt", "cancelRequestedAt", "finishedAt"], "properties": {"createdAt": {"type": "string", "format": "date-time"}, "updatedAt": {"type": "string", "format": "date-time"}, "inputClosedAt": {"type": ["string", "null"], "format": "date-time"}, "queuedAt": {"type": ["string", "null"], "format": "date-time"}, "startedAt": {"type": ["string", "null"], "format": "date-time"}, "cancelRequestedAt": {"type": ["string", "null"], "format": "date-time"}, "finishedAt": {"type": ["string", "null"], "format": "date-time"}}},
    "device": {"type": "object", "additionalProperties": false, "required": ["requested", "selected"], "properties": {"requested": {"enum": ["cpu", "gpu", "auto"]}, "selected": {"enum": ["cpu", "gpu", null]}}},
    "sourceEncoding": {"$ref": "common.schema.json#/$defs/sourceEncoding"}, "dataContract": {"$ref": "common.schema.json#/$defs/dataContract"}, "modelContract": {"$ref": "common.schema.json#/$defs/modelContract"}, "semanticDigests": {"$ref": "common.schema.json#/$defs/semanticDigests"}, "jobConfigSha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "initialization": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/resolvedInitialization"}]}, "resolvedModelRef": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "predictionColumn": {"$ref": "common.schema.json#/$defs/predictionColumn"}, "progress": {"type": "object"},
    "recovery": {"type": ["object", "null"], "additionalProperties": false, "required": ["latestCheckpoint", "resumedFromGeneration", "retryCount", "lastRetryCode", "boundary"], "properties": {"latestCheckpoint": {"type": ["object", "null"], "additionalProperties": false, "required": ["generation", "completedEpochs", "globalStep", "trainingComplete"], "properties": {"generation": {"type": "integer", "minimum": 1}, "completedEpochs": {"type": "integer", "minimum": 1}, "globalStep": {"type": "integer", "minimum": 0}, "trainingComplete": {"type": "boolean"}}}, "resumedFromGeneration": {"type": ["integer", "null"], "minimum": 1}, "retryCount": {"type": "integer", "minimum": 0}, "lastRetryCode": {"type": ["string", "null"]}, "boundary": {"const": "globalEpoch"}}},
    "error": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "detail"],
          "properties": {
            "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
            "message": {"type": "string", "minLength": 1, "maxLength": 1024},
            "detail": {
              "oneOf": [
                {"type": "null"},
                {"$ref": "error-detail.schema.json"}
              ]
            }
          }
        }
      ]
    },
    "results": {"type": "object", "additionalProperties": false, "required": ["outputCount", "modelRef", "checkpoint"], "properties": {"outputCount": {"type": "integer", "minimum": 0}, "modelRef": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}, "checkpoint": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["format", "sha256", "bytes", "generation"], "properties": {"format": {"const": "transformer-checkpoint-v6"}, "sha256": {"$ref": "common.schema.json#/$defs/sha256"}, "bytes": {"type": "integer", "minimum": 1}, "generation": {"type": "integer", "minimum": 1}}}]}}},
    "pollAfterMs": {"type": "integer", "minimum": 0}
  },
  "$defs": {"emptyProgress": {"type": "object", "maxProperties": 0}, "fitProgress": {"type": "object", "additionalProperties": false, "required": ["epoch", "step", "loss"], "properties": {"epoch": {"type": "integer", "minimum": 1}, "step": {"type": "integer", "minimum": 0}, "loss": {"type": "number"}}}, "predictProgress": {"type": "object", "additionalProperties": false, "required": ["ordinal", "rows"], "properties": {"ordinal": {"type": "integer", "minimum": 0}, "rows": {"type": "integer", "minimum": 0}}}},
  "allOf": [
    {"if": {"properties": {"operation": {"const": "fit"}}}, "then": {"properties": {"initialization": {"$ref": "common.schema.json#/$defs/resolvedInitialization"}, "resolvedModelRef": {"const": null}, "progress": {"oneOf": [{"$ref": "#/$defs/emptyProgress"}, {"$ref": "#/$defs/fitProgress"}]}}}},
    {"if": {"properties": {"operation": {"const": "predict"}}}, "then": {"properties": {"initialization": {"const": null}, "resolvedModelRef": {"$ref": "common.schema.json#/$defs/label"}, "progress": {"oneOf": [{"$ref": "#/$defs/emptyProgress"}, {"$ref": "#/$defs/predictProgress"}]}}}}
  ]
}
