{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v8/cancel-result.schema.json",
  "title": "transformer.v8.job.cancel result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "version", "requestId", "jobId", "revision", "input",
    "execution"
  ],
  "properties": {
    "contract": {"const": "transformer-flight"},
    "version": {"const": 8},
    "requestId": {"$ref": "common.schema.json#/$defs/uuid"},
    "jobId": {"$ref": "common.schema.json#/$defs/uuid"},
    "revision": {"type": "integer", "minimum": 1},
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {"state": {"$ref": "common.schema.json#/$defs/inputState"}}
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {"state": {"$ref": "common.schema.json#/$defs/executionState"}}
    }
  }
}
