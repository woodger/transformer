{
  "contract": "transformer-flight",
  "version": 13,
  "requestId": "11111111-1111-4111-8111-111111111111",
  "protocolVersions": [13],
  "workerProtocolVersion": 12,
  "checkpointFormat": "transformer-checkpoint-v6",
  "recoveryFormat": "transformer-recovery-v6",
  "metricsFormats": [
    "transformer.fit-run-summary.v5",
    "transformer.training-metrics.v5"
  ],
  "service": {
    "name": "transformer-flight",
    "version": "0.2.0",
    "pyarrowVersion": "23.0.0",
    "torchVersion": "2.12.0"
  },
  "schemaIds": {
    "fitInput": "transformer.indexed-feature-blocks.fit.v1",
    "predictInput": "transformer.indexed-feature-blocks.predict.v1",
    "predictionOutput": "transformer.prediction.target-aligned.v3"
  },
  "sourceEncodings": ["indexedFeatureBlocks"],
  "semantic": {
    "objectiveLanguage": {
      "revision": 1,
      "constraints": ["ClosedInterval", "Finite"],
      "transformations": ["Identity", "Sigmoid", "Tanh"],
      "resourceKinds": ["PositiveScalarPerObservation"],
      "directOperators": [
        "BinaryCrossEntropyWithLogits",
        "LogMSE",
        "SmoothL1"
      ],
      "auxiliaryOperators": [
        "ExpectedValue",
        "GaussianNLL",
        "RiskAdjustedExpectedValue"
      ],
      "aggregations": ["WeightedSum"],
      "reductions": ["GlobalRowMean"]
    },
    "semanticLimits": {
      "maxTargetSlots": 128,
      "maxObjectiveComponents": 256,
      "maxPrivateResources": 64
    },
    "modelArchitectures": [
      {"identity": "transformer.sequence-model", "revision": 1}
    ]
  },
  "modelCatalog": {
    "contract": "transformer-model-catalog",
    "revision": 1,
    "operations": ["detail", "list"],
    "transport": {
      "kind": "ArrowFlightDoAction",
      "actions": {
        "detail": "transformer.model-catalog.v1.detail",
        "list": "transformer.model-catalog.v1.list"
      }
    },
    "consistency": {
      "kind": "LiveHighWater",
      "ordering": [
        {"field": "createdAt", "direction": "DESC"},
        {"field": "modelRef", "direction": "ASC"}
      ],
      "concurrentPublication": "ExcludedAfterHighWater",
      "concurrentDeletion": "MayOmit",
      "cursorExpiration": "RestartTraversal"
    },
    "limits": {
      "maxPageSize": 100,
      "cursorTtlSeconds": 900,
      "maxResponseBytes": 8388608,
      "maxCheckpointVerificationsPerDetail": 1,
      "maxCheckpointVerificationBytes": 1073741824
    },
    "features": {
      "ownerScope": "AuthenticatedSubject",
      "filters": false,
      "batchDetail": false,
      "serverSideComparison": false,
      "checkpointVerification": "FullSha256",
      "structuredErrors": true
    }
  },
  "trainingTelemetry": {
    "contract": "transformer-training-telemetry",
    "revision": 1,
    "operations": ["report", "gradientInteractions"],
    "transport": {
      "kind": "ArrowFlightDoAction",
      "actions": {
        "report": "transformer.training-telemetry.v1.report",
        "gradientInteractions": "transformer.training-telemetry.v1.gradient-interactions"
      }
    },
    "metricFamilies": [
      "epochLosses",
      "targetErrors",
      "optimizerHealth",
      "gradientInteractions"
    ],
    "availabilityStates": ["pending", "unavailable", "available"],
    "gradientAvailabilityStates": [
      "notConfigured",
      "configuredWithoutObservations",
      "available"
    ],
    "epochObservation": {
      "kind": "PreOptimizerUpdateEpochPass",
      "checkpointReevaluation": false
    },
    "outcomePrecedence": [
      "ModelLookup",
      "Pending",
      "Unavailable",
      "IntegrityFailure",
      "Available"
    ],
    "limits": {
      "maxEpochPageSize": 100,
      "maxGradientPairPageSize": 1000,
      "cursorTtlSeconds": 900,
      "maxResponseBytes": 8388608,
      "maxRetainedSnapshotCount": 64,
      "maxRetainedSnapshotBytes": 16777216,
      "maxRetainedSnapshotTotalBytes": 67108864
    },
    "features": {
      "ownerScope": "AuthenticatedSubject",
      "selector": "ExactModelRef",
      "batchQuery": false,
      "partialReports": false,
      "checkpointVerification": false,
      "structuredErrors": true,
      "cursorRestartOutcome": "TELEMETRY_CURSOR_INVALIDATED",
      "snapshotAdmission": "AtomicNoLiveEviction"
    }
  },
  "limits": {
    "maxMessageBytes": 16777216,
    "targetBatchBytes": 8388608,
    "maxBatchBytes": 16777216,
    "maxPayloadBytes": 536870912,
    "maxRowsPerPayload": 2000000,
    "maxPayloadsPerJob": 100000,
    "maxJobBytes": 68719476736,
    "maxActiveJobsPerSubject": 32,
    "maxPageItems": 100,
    "inputIdleTimeoutSeconds": 900,
    "transportMessageLimitEnforced": false
  },
  "devices": {
    "cpu": {"available": true},
    "gpu": {"available": true, "deviceCount": 1, "quarantinedCount": 0}
  },
  "queue": {"cpuCapacity": 1, "gpuCapacity": 1, "singleInstance": true},
  "supportedOperations": ["fit", "predict"],
  "fitInitializations": ["publishedModel", "random"],
  "features": {
    "doExchange": false,
    "pollFlightInfo": false,
    "durableStreamingInput": true,
    "clientGeneratedJobId": true,
    "crossSystemFencing": true,
    "revisionPagination": true,
    "resumableFit": true,
    "recoveryBoundary": "globalEpoch",
    "deviceAwareGpu": true,
    "structuredErrorDetails": true
  }
}
