{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v7/common.schema.json",
  "title": "Transformer Flight v7 common definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "fencingToken": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$"
    },
    "predictionColumn": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]{0,63}$"
    },
    "inputState": {"enum": ["OPEN", "CLOSED", "ABORTED"]},
    "executionState": {
      "enum": [
        "WAITING_INPUT", "QUEUED", "RUNNING", "RETRYING",
        "CANCELLING", "SUCCEEDED", "FAILED", "CANCELLED"
      ]
    },
    "targetName": {
      "enum": [
        "MeanReturn", "SigmaReturn", "ProbTP", "ProbSL",
        "VolatilityNext", "HittingProbTP"
      ]
    },
    "targets": {
      "type": "array",
      "items": {"$ref": "#/$defs/targetName"},
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true
    },
    "dataContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "version", "profile", "dataContractSha256", "seqLen",
        "featureDim", "targetSchemaId"
      ],
      "properties": {
        "id": {"const": "inventory.learning-dataset"},
        "version": {"const": 2},
        "profile": {"$ref": "#/$defs/label"},
        "dataContractSha256": {"$ref": "#/$defs/sha256"},
        "seqLen": {"type": "integer", "minimum": 1},
        "featureDim": {"type": "integer", "minimum": 1},
        "targetSchemaId": {"const": "inventory.target.v2"}
      }
    },
    "mlContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetSchemaId", "predictionSchemaId", "objectiveId",
        "objectiveConfigSha256", "checkpointFormat", "targetWidth",
        "predictionSpace", "targets", "objective"
      ],
      "properties": {
        "targetSchemaId": {"const": "inventory.target.v2"},
        "predictionSchemaId": {
          "const": "transformer.prediction.target-aligned.v3"
        },
        "objectiveId": {"const": "transformer.objective.declarative.v1"},
        "objectiveConfigSha256": {"$ref": "#/$defs/sha256"},
        "checkpointFormat": {"const": "transformer-checkpoint-v5"},
        "targetWidth": {"type": "integer", "minimum": 1, "maximum": 6},
        "predictionSpace": {"const": "target"},
        "targets": {"$ref": "#/$defs/targets"},
        "objective": {"$ref": "objective-config.schema.json"}
      }
    },
    "advertisedMlContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetSchemaId", "predictionSchemaId", "objectiveId",
        "checkpointFormat", "targetIdentities", "minimumTargetWidth",
        "maximumTargetWidth", "predictionSpace", "objectiveSchemaVersion",
        "diagnosticsSchemaVersion", "directLossOperators",
        "auxiliaryLossOperators", "balancingOperators"
      ],
      "properties": {
        "targetSchemaId": {"const": "inventory.target.v2"},
        "predictionSchemaId": {
          "const": "transformer.prediction.target-aligned.v3"
        },
        "objectiveId": {"const": "transformer.objective.declarative.v1"},
        "checkpointFormat": {"const": "transformer-checkpoint-v5"},
        "targetIdentities": {
          "type": "array",
          "prefixItems": [
            {"const": "MeanReturn"},
            {"const": "SigmaReturn"},
            {"const": "ProbTP"},
            {"const": "ProbSL"},
            {"const": "VolatilityNext"},
            {"const": "HittingProbTP"}
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        },
        "minimumTargetWidth": {"const": 1},
        "maximumTargetWidth": {"const": 6},
        "predictionSpace": {"const": "target"},
        "objectiveSchemaVersion": {"const": 1},
        "diagnosticsSchemaVersion": {"const": 1},
        "directLossOperators": {
          "const": ["SmoothL1", "BinaryCrossEntropyWithLogits", "LogMSE"]
        },
        "auxiliaryLossOperators": {
          "const": [
            "GaussianNLL", "ExpectedValue", "RiskAdjustedExpectedValue"
          ]
        },
        "balancingOperators": {"const": ["Static"]}
      }
    },
    "modelConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seqLen", "hidden", "layers", "dropout", "nhead", "mode",
        "outDim", "featureDim"
      ],
      "properties": {
        "seqLen": {"type": "integer", "minimum": 1},
        "hidden": {"type": "integer", "minimum": 1},
        "layers": {"type": "integer", "minimum": 1},
        "dropout": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "nhead": {"type": "integer", "minimum": 1},
        "mode": {"enum": ["strict", "relaxed"]},
        "outDim": {"type": "integer", "minimum": 1, "maximum": 6},
        "featureDim": {"type": "integer", "minimum": 1}
      }
    },
    "selectionConfig": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["minDelta", "patience"],
          "properties": {
            "minDelta": {"type": "number", "minimum": 0},
            "patience": {"type": "integer", "minimum": 0}
          }
        }
      ]
    },
    "trainingConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lr", "batchSize", "epochs", "useAmp", "weightDecay",
        "selection", "seed", "deterministic"
      ],
      "properties": {
        "lr": {"type": "number", "exclusiveMinimum": 0},
        "batchSize": {"type": "integer", "minimum": 1},
        "epochs": {"type": "integer", "minimum": 1},
        "useAmp": {"type": "boolean"},
        "weightDecay": {"type": "number", "minimum": 0},
        "selection": {"$ref": "#/$defs/selectionConfig"},
        "seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "deterministic": {"type": "boolean"}
      }
    },
    "objectiveConfig": {"$ref": "objective-config.schema.json"},
    "diagnosticsConfig": {"$ref": "diagnostics.schema.json"},
    "checkpointSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled", "objectiveConfigSha256", "bestSelectionScore",
        "bestFrame", "bestEpoch", "source"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "objectiveConfigSha256": {"$ref": "#/$defs/sha256"},
        "bestSelectionScore": {"type": ["number", "null"]},
        "bestFrame": {"type": ["integer", "null"], "minimum": 0},
        "bestEpoch": {"type": ["integer", "null"], "minimum": 1},
        "source": {
          "enum": ["best_selection_score", "last_epoch"]
        }
      }
    },
    "checkpointSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format", "serviceVersion", "sha256", "bytes", "generation",
        "modelConfig", "trainingConfig", "dataContract", "mlContract",
        "objective", "diagnostics", "checkpointSelection"
      ],
      "properties": {
        "format": {"const": "transformer-checkpoint-v5"},
        "serviceVersion": {"type": "string", "minLength": 1, "maxLength": 64},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "generation": {"type": "integer", "minimum": 1},
        "modelConfig": {"$ref": "#/$defs/modelConfig"},
        "trainingConfig": {"$ref": "#/$defs/trainingConfig"},
        "dataContract": {"$ref": "#/$defs/dataContract"},
        "mlContract": {"$ref": "#/$defs/mlContract"},
        "objective": {
          "type": "object",
          "additionalProperties": false,
          "required": ["targets", "objective"],
          "properties": {
            "targets": {"$ref": "#/$defs/targets"},
            "objective": {"$ref": "objective-config.schema.json"}
          }
        },
        "diagnostics": {"$ref": "#/$defs/diagnosticsConfig"},
        "checkpointSelection": {"$ref": "#/$defs/checkpointSelection"}
      }
    },
    "inputReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payloadId", "ordinal", "commitRevision", "schemaId",
        "dataContractSha256", "rows", "batches", "bytes", "sha256",
        "schemaFingerprint"
      ],
      "properties": {
        "payloadId": {"$ref": "#/$defs/uuid"},
        "ordinal": {"type": "integer", "minimum": 0},
        "commitRevision": {"type": "integer", "minimum": 1},
        "schemaId": {
          "enum": ["inventory.sequence.fit.v3", "inventory.sequence.predict.v2"]
        },
        "dataContractSha256": {"$ref": "#/$defs/sha256"},
        "rows": {"type": "integer", "minimum": 0},
        "batches": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"},
        "schemaFingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "outputReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "descriptorPath", "rows", "bytes", "sha256"],
      "properties": {
        "ordinal": {"type": "integer", "minimum": 0},
        "descriptorPath": {
          "type": "array",
          "prefixItems": [
            {"const": "transformer"},
            {"const": "v7"},
            {"const": "jobs"},
            {"$ref": "#/$defs/uuid"},
            {"const": "outputs"},
            {"type": "string", "pattern": "^(0|[1-9][0-9]*)$"}
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        },
        "rows": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 0},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
