{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v7/upload-metadata.schema.json",
  "title": "Transformer Flight v7 DoPut application metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "version", "jobId", "clientExecutionId", "fencingToken",
    "payloadId", "ordinal", "schemaId", "dataContractSha256", "rows"
  ],
  "properties": {
    "contract": {"const": "transformer-flight"},
    "version": {"const": 7},
    "jobId": {"$ref": "common.schema.json#/$defs/uuid"},
    "clientExecutionId": {"$ref": "common.schema.json#/$defs/uuid"},
    "fencingToken": {"$ref": "common.schema.json#/$defs/fencingToken"},
    "payloadId": {"$ref": "common.schema.json#/$defs/uuid"},
    "ordinal": {"type": "integer", "minimum": 0, "maximum": 99999},
    "schemaId": {
      "enum": ["inventory.sequence.fit.v3", "inventory.sequence.predict.v2"]
    },
    "dataContractSha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "rows": {"type": "integer", "minimum": 0}
  }
}
