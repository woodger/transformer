{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/worker/v20/event.schema.json",
  "title": "Transformer worker v20 event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "protocolVersion",
    "jobId",
    "attempt",
    "attemptId",
    "sequence",
    "type",
    "payload"
  ],
  "properties": {
    "contract": {
      "const": "transformer-worker"
    },
    "protocolVersion": {
      "const": 20
    },
    "jobId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "attemptId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "type": {
      "enum": [
        "ready",
        "input.ack",
        "input.waiting",
        "progress",
        "checkpoint",
        "completed",
        "error"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "ready"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pid",
              "nextOrdinal",
              "inputRevision"
            ],
            "properties": {
              "pid": {
                "type": "integer",
                "minimum": 1
              },
              "nextOrdinal": {
                "type": "integer",
                "minimum": 0
              },
              "inputRevision": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "input.ack"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ordinal",
              "nextOrdinal",
              "inputRevision"
            ],
            "properties": {
              "ordinal": {
                "type": "integer",
                "minimum": 0
              },
              "nextOrdinal": {
                "type": "integer",
                "minimum": 1
              },
              "inputRevision": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "input.waiting"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "nextOrdinal",
              "inputRevision"
            ],
            "properties": {
              "nextOrdinal": {
                "type": "integer",
                "minimum": 0
              },
              "inputRevision": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "progress"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "progress"
            ],
            "properties": {
              "progress": {
                "$ref": "common.schema.json#/$defs/progressEvent"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "checkpoint"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "generation",
              "progress",
              "artifact"
            ],
            "properties": {
              "generation": {
                "type": "integer",
                "minimum": 1
              },
              "progress": {
                "$ref": "common.schema.json#/$defs/progress"
              },
              "artifact": {
                "$ref": "common.schema.json#/$defs/checkpointArtifact"
              },
              "checkpointSerializationMs": {
                "type": "number",
                "minimum": 0
              },
              "metrics": {
                "$ref": "training-metrics.schema.json"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "completed"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "resultManifest"
            ],
            "properties": {
              "resultManifest": {
                "$ref": "common.schema.json#/$defs/artifact"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "error"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message",
              "detail"
            ],
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "detail": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "https://transformer.local/contracts/semantic/v5/error-detail.schema.json"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
