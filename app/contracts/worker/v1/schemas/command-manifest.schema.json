{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/worker/v1/command-manifest.schema.json",
  "title": "Transformer worker v1 command manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "protocolVersion", "jobId", "attempt", "attemptId",
    "operation", "device", "inputs", "workspace", "model"
  ],
  "properties": {
    "contract": {"const": "transformer-worker"},
    "protocolVersion": {"const": 1},
    "jobId": {
      "$ref": "https://transformer.local/contracts/worker/v1/common.schema.json#/$defs/uuid"
    },
    "attempt": {"type": "integer", "minimum": 1},
    "attemptId": {
      "$ref": "https://transformer.local/contracts/worker/v1/common.schema.json#/$defs/uuid"
    },
    "operation": {"enum": ["fit", "predict"]},
    "predictionColumn": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["cpu", "cuda"]},
        "opaqueId": {"type": "string", "minLength": 1, "maxLength": 128}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "cuda"}}},
          "then": {"required": ["opaqueId"]},
          "else": {"not": {"required": ["opaqueId"]}}
        }
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "https://transformer.local/contracts/worker/v1/arrow-manifest.schema.json"
      },
      "maxItems": 400
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": {
        "root": {
          "$ref": "https://transformer.local/contracts/worker/v1/common.schema.json#/$defs/path"
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 128},
        "config": {
          "$ref": "https://transformer.local/contracts/worker/v1/common.schema.json#/$defs/modelConfig"
        },
        "checkpoint": {
          "$ref": "https://transformer.local/contracts/worker/v1/common.schema.json#/$defs/artifact"
        }
      }
    },
    "training": {
      "$ref": "https://transformer.local/contracts/worker/v1/common.schema.json#/$defs/trainingConfig"
    },
    "recovery": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["configSha256", "manifestSha256"],
      "properties": {
        "configSha256": {
          "$ref": "https://transformer.local/contracts/worker/v1/common.schema.json#/$defs/sha256"
        },
        "manifestSha256": {
          "$ref": "https://transformer.local/contracts/worker/v1/common.schema.json#/$defs/sha256"
        },
        "checkpoint": {
          "$ref": "https://transformer.local/contracts/worker/v1/common.schema.json#/$defs/artifact"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "fit"}}},
      "then": {
        "required": ["training"],
        "properties": {"model": {"required": ["label"]}}
      },
      "else": {
        "required": ["predictionColumn"],
        "not": {"anyOf": [{"required": ["training"]}, {"required": ["recovery"]}]},
        "properties": {"model": {"required": ["checkpoint"]}}
      }
    }
  ]
}
