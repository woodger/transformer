{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/worker/v2/result-manifest.schema.json",
  "title": "Transformer worker v2 completed result manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "protocolVersion", "jobId", "attempt", "attemptId",
    "operation", "inputRevision", "manifestSha256", "artifacts"
  ],
  "properties": {
    "contract": {"const": "transformer-worker"},
    "protocolVersion": {"const": 2},
    "jobId": {
      "$ref": "https://transformer.local/contracts/worker/v2/common.schema.json#/$defs/uuid"
    },
    "attempt": {"type": "integer", "minimum": 1},
    "attemptId": {
      "$ref": "https://transformer.local/contracts/worker/v2/common.schema.json#/$defs/uuid"
    },
    "operation": {"enum": ["fit", "predict"]},
    "inputRevision": {"type": "integer", "minimum": 0},
    "manifestSha256": {
      "$ref": "https://transformer.local/contracts/worker/v2/common.schema.json#/$defs/sha256"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "https://transformer.local/contracts/worker/v2/arrow-manifest.schema.json"
      },
      "maxItems": 100000
    },
    "checkpoint": {
      "$ref": "https://transformer.local/contracts/worker/v2/common.schema.json#/$defs/artifact"
    },
    "metrics": {
      "$ref": "https://transformer.local/contracts/worker/v2/common.schema.json#/$defs/artifact"
    },
    "checkpointMetadata": {
      "$ref": "https://transformer.local/contracts/worker/v2/common.schema.json#/$defs/checkpointMetadata"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "fit"}}},
      "then": {
        "required": ["checkpoint", "metrics", "checkpointMetadata"],
        "properties": {"artifacts": {"maxItems": 0}}
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["checkpoint"]},
            {"required": ["metrics"]},
            {"required": ["checkpointMetadata"]}
          ]
        }
      }
    }
  ]
}
