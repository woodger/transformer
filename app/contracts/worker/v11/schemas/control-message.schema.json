{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/worker/v11/control-message.schema.json",
  "title": "Transformer worker v11 service-to-worker control message",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "protocolVersion", "jobId", "attempt", "attemptId",
    "sequence", "type", "payload"
  ],
  "properties": {
    "contract": {"const": "transformer-worker"},
    "protocolVersion": {"const": 11},
    "jobId": {
      "$ref": "https://transformer.local/contracts/worker/v11/common.schema.json#/$defs/uuid"
    },
    "attempt": {"type": "integer", "minimum": 1},
    "attemptId": {
      "$ref": "https://transformer.local/contracts/worker/v11/common.schema.json#/$defs/uuid"
    },
    "sequence": {"type": "integer", "minimum": 1},
    "type": {"enum": ["input.committed", "input.closed"]},
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "input.committed"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "inputRevision"],
            "properties": {
              "inputRevision": {"type": "integer", "minimum": 1},
              "input": {
                "$ref": "https://transformer.local/contracts/worker/v11/arrow-manifest.schema.json"
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "input.closed"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "inputRevision", "payloadCount", "totalChunks",
              "totalLogicalRows", "totalNativeRows", "rangeCount",
              "totalBytes", "manifestSha256"
            ],
            "properties": {
              "inputRevision": {"type": "integer", "minimum": 0},
              "payloadCount": {"type": "integer", "minimum": 0},
              "totalChunks": {"type": "integer", "minimum": 0},
              "totalLogicalRows": {"type": "integer", "minimum": 0},
              "totalNativeRows": {
                "$ref": "https://transformer.local/contracts/worker/v11/common.schema.json#/$defs/nativeRows"
              },
              "rangeCount": {"type": "integer", "minimum": 0},
              "totalBytes": {"type": "integer", "minimum": 0},
              "manifestSha256": {
                "$ref": "https://transformer.local/contracts/worker/v11/common.schema.json#/$defs/sha256"
              }
            }
          }
        }
      }
    }
  ]
}
