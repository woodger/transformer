{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/worker/v6/result-manifest.schema.json",
  "title": "Transformer worker v6 completed result manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "protocolVersion", "jobId", "attempt", "attemptId",
    "operation", "inputRevision", "manifestSha256", "artifacts"
  ],
  "properties": {
    "contract": {"const": "transformer-worker"},
    "protocolVersion": {"const": 6},
    "jobId": {
      "$ref": "https://transformer.local/contracts/worker/v6/common.schema.json#/$defs/uuid"
    },
    "attempt": {"type": "integer", "minimum": 1},
    "attemptId": {
      "$ref": "https://transformer.local/contracts/worker/v6/common.schema.json#/$defs/uuid"
    },
    "operation": {"enum": ["fit", "predict"]},
    "inputRevision": {"type": "integer", "minimum": 0},
    "manifestSha256": {
      "$ref": "https://transformer.local/contracts/worker/v6/common.schema.json#/$defs/sha256"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "https://transformer.local/contracts/worker/v6/arrow-manifest.schema.json"
      },
      "maxItems": 100000
    },
    "checkpoint": {
      "$ref": "https://transformer.local/contracts/worker/v6/common.schema.json#/$defs/artifact"
    },
    "checkpointMetadata": {
      "$ref": "https://transformer.local/contracts/worker/v6/common.schema.json#/$defs/checkpointMetadata"
    },
    "checkpointSerializationMs": {"type": "number", "minimum": 0},
    "targetStatistics": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/meanTargetStatistic"},
            {"properties": {"targetIndex": {"const": 0}, "name": {"const": "meanReturn"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/unitTargetStatistic"},
            {"properties": {"targetIndex": {"const": 1}, "name": {"const": "sigmaReturn"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/unitTargetStatistic"},
            {"properties": {"targetIndex": {"const": 2}, "name": {"const": "probTP"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/unitTargetStatistic"},
            {"properties": {"targetIndex": {"const": 3}, "name": {"const": "probSL"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/unitTargetStatistic"},
            {"properties": {"targetIndex": {"const": 4}, "name": {"const": "volatilityNext"}}}
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/unitTargetStatistic"},
            {"properties": {"targetIndex": {"const": 5}, "name": {"const": "hittingProbTP"}}}
          ]
        }
      ]
    }
  },
  "$defs": {
    "targetStatistic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetIndex", "name", "count", "min", "max", "mean", "std",
        "zeroCount", "oneCount"
      ],
      "properties": {
        "targetIndex": {"type": "integer", "minimum": 0, "maximum": 5},
        "name": {"type": "string"},
        "count": {"type": "integer", "minimum": 1},
        "min": {"type": "number"},
        "max": {"type": "number"},
        "mean": {"type": "number"},
        "std": {"type": "number", "minimum": 0},
        "zeroCount": {"type": "integer", "minimum": 0},
        "oneCount": {"type": "integer", "minimum": 0}
      }
    },
    "meanTargetStatistic": {
      "allOf": [
        {"$ref": "#/$defs/targetStatistic"},
        {
          "properties": {
            "min": {"minimum": -1, "maximum": 1},
            "max": {"minimum": -1, "maximum": 1},
            "mean": {"minimum": -1, "maximum": 1}
          }
        }
      ]
    },
    "unitTargetStatistic": {
      "allOf": [
        {"$ref": "#/$defs/targetStatistic"},
        {
          "properties": {
            "min": {"minimum": 0, "maximum": 1},
            "max": {"minimum": 0, "maximum": 1},
            "mean": {"minimum": 0, "maximum": 1}
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "fit"}}},
      "then": {
        "required": [
          "checkpoint", "checkpointMetadata", "checkpointSerializationMs",
          "targetStatistics"
        ],
        "properties": {"artifacts": {"maxItems": 0}}
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["checkpoint"]},
            {"required": ["checkpointMetadata"]},
            {"required": ["checkpointSerializationMs"]},
            {"required": ["targetStatistics"]}
          ]
        }
      }
    }
  ]
}
