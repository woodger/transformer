{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/worker/v10/event.schema.json",
  "title": "Transformer worker v10 event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "protocolVersion", "jobId", "attempt", "attemptId",
    "sequence", "type", "payload"
  ],
  "properties": {
    "contract": {"const": "transformer-worker"},
    "protocolVersion": {"const": 10},
    "jobId": {
      "$ref": "https://transformer.local/contracts/worker/v10/common.schema.json#/$defs/uuid"
    },
    "attempt": {"type": "integer", "minimum": 1},
    "attemptId": {
      "$ref": "https://transformer.local/contracts/worker/v10/common.schema.json#/$defs/uuid"
    },
    "sequence": {"type": "integer", "minimum": 1},
    "type": {
      "enum": [
        "ready", "input.ack", "input.waiting", "progress", "checkpoint",
        "completed", "error"
      ]
    },
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "ready"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pid", "nextOrdinal", "inputRevision"],
            "properties": {
              "pid": {"type": "integer", "minimum": 1},
              "nextOrdinal": {"type": "integer", "minimum": 0},
              "inputRevision": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "input.ack"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "nextOrdinal", "inputRevision"],
            "properties": {
              "ordinal": {"type": "integer", "minimum": 0},
              "nextOrdinal": {"type": "integer", "minimum": 1},
              "inputRevision": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "input.waiting"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["nextOrdinal", "inputRevision"],
            "properties": {
              "nextOrdinal": {"type": "integer", "minimum": 0},
              "inputRevision": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "progress"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["progress"],
            "properties": {"progress": {"type": "object"}}
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "checkpoint"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "generation", "completedEpochs", "globalStep",
              "progress", "trainingComplete", "artifact"
            ],
            "properties": {
              "generation": {"type": "integer", "minimum": 1},
              "completedEpochs": {"type": "integer", "minimum": 1},
              "globalStep": {"type": "integer", "minimum": 0},
              "progress": {
                "type": "object",
                "additionalProperties": false,
                "required": ["epoch", "step", "loss"],
                "properties": {
                  "epoch": {"type": "integer", "minimum": 1},
                  "step": {"type": "integer", "minimum": 0},
                  "loss": {"type": "number"}
                }
              },
              "trainingComplete": {"type": "boolean"},
              "artifact": {
                "$ref": "https://transformer.local/contracts/worker/v10/common.schema.json#/$defs/artifact"
              },
              "checkpointSerializationMs": {},
              "metrics": {}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "completed"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resultManifest"],
            "properties": {
              "resultManifest": {
                "$ref": "https://transformer.local/contracts/worker/v10/common.schema.json#/$defs/artifact"
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"type": {"const": "error"}}},
      "then": {
        "properties": {
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "message"],
            "properties": {
              "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
              "message": {"type": "string", "minLength": 1, "maxLength": 1024}
            }
          }
        }
      }
    }
  ]
}
