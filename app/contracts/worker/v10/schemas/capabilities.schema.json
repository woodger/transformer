{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/worker/v10/capabilities.schema.json",
  "title": "Transformer worker v10 capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "protocolVersion", "torchVersion", "cudaRuntimeVersion",
    "devices"
  ],
  "properties": {
    "contract": {"const": "transformer-worker"},
    "protocolVersion": {"const": 10},
    "torchVersion": {"type": "string", "minLength": 1},
    "cudaRuntimeVersion": {"type": ["string", "null"]},
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ordinal", "name"],
        "properties": {
          "ordinal": {"type": "integer", "minimum": 0},
          "name": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
