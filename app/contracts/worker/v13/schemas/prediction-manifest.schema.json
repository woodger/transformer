{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/worker/v13/prediction-manifest.schema.json",
  "title": "Transformer worker v13 prediction artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaId",
    "ordinal",
    "commitRevision",
    "dataContractSha256",
    "modelContractSha256",
    "rows",
    "artifact"
  ],
  "properties": {
    "schemaId": {
      "const": "transformer.prediction.target-aligned.v3"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 0
    },
    "commitRevision": {
      "type": "integer",
      "minimum": 1
    },
    "dataContractSha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "modelContractSha256": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "rows": {
      "type": "integer",
      "minimum": 0
    },
    "artifact": {
      "$ref": "common.schema.json#/$defs/artifact"
    }
  }
}
