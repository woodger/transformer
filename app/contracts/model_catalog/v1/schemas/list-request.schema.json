{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/model-catalog/v1/list-request.schema.json",
  "title": "transformer.model-catalog.v1.list request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "revision", "requestId", "pageSize", "cursor"],
  "properties": {
    "contract": {"const": "transformer-model-catalog"},
    "revision": {"const": 1},
    "requestId": {"$ref": "common.schema.json#/$defs/uuid"},
    "pageSize": {"type": "integer", "minimum": 1, "maximum": 100},
    "cursor": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/cursor"}
      ]
    }
  }
}
