{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/model-catalog/v1/error-detail.schema.json",
  "title": "Transformer model catalog query v1 structured error detail",
  "oneOf": [
    {"$ref": "#/$defs/invalidQuery"},
    {"$ref": "#/$defs/invalidCursor"},
    {"$ref": "#/$defs/expiredCursor"},
    {"$ref": "#/$defs/unavailableCapability"},
    {"$ref": "#/$defs/modelNotFound"},
    {"$ref": "#/$defs/storedMetadataInvalid"},
    {"$ref": "#/$defs/checkpointUnavailable"},
    {"$ref": "#/$defs/checkpointSizeMismatch"},
    {"$ref": "#/$defs/checkpointDigestMismatch"},
    {"$ref": "#/$defs/checkpointBudgetExceeded"},
    {"$ref": "#/$defs/responseBudgetExceeded"},
    {"$ref": "#/$defs/registryUnavailable"}
  ],
  "$defs": {
    "message": {"type": "string", "minLength": 1, "maxLength": 1024},
    "pointer": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^(?:/(?:[^~/]|~0|~1)*)*$"
    },
    "invalidQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason", "path", "message"],
      "properties": {
        "code": {"const": "INVALID_ARGUMENT"},
        "reason": {"const": "INVALID_CATALOG_QUERY"},
        "path": {"$ref": "#/$defs/pointer"},
        "message": {"$ref": "#/$defs/message"}
      }
    },
    "invalidCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason", "path", "message"],
      "properties": {
        "code": {"const": "INVALID_ARGUMENT"},
        "reason": {"const": "INVALID_CATALOG_CURSOR"},
        "path": {"const": "/cursor"},
        "message": {"$ref": "#/$defs/message"}
      }
    },
    "expiredCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code", "reason", "path", "restartRequired", "message"
      ],
      "properties": {
        "code": {"const": "FAILED_PRECONDITION"},
        "reason": {"const": "CATALOG_CURSOR_EXPIRED"},
        "path": {"const": "/cursor"},
        "restartRequired": {"const": true},
        "message": {"$ref": "#/$defs/message"}
      }
    },
    "unavailableCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason", "requestedRevision", "message"],
      "properties": {
        "code": {"const": "FAILED_PRECONDITION"},
        "reason": {"const": "CATALOG_QUERY_REVISION_UNAVAILABLE"},
        "requestedRevision": {"$ref": "common.schema.json#/$defs/positiveInteger"},
        "message": {"$ref": "#/$defs/message"}
      }
    },
    "modelNotFound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason", "modelRef", "message"],
      "properties": {
        "code": {"const": "NOT_FOUND"},
        "reason": {"const": "MODEL_NOT_FOUND"},
        "modelRef": {"$ref": "common.schema.json#/$defs/modelRef"},
        "message": {"$ref": "#/$defs/message"}
      }
    },
    "storedMetadataInvalid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason", "modelRef", "path", "message"],
      "properties": {
        "code": {"const": "MODEL_CORRUPT"},
        "reason": {"const": "STORED_MODEL_METADATA_INVALID"},
        "modelRef": {"$ref": "common.schema.json#/$defs/modelRef"},
        "path": {"$ref": "#/$defs/pointer"},
        "message": {"$ref": "#/$defs/message"}
      }
    },
    "checkpointUnavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason", "modelRef", "message"],
      "properties": {
        "code": {"const": "MODEL_CORRUPT"},
        "reason": {"const": "MODEL_CHECKPOINT_UNAVAILABLE"},
        "modelRef": {"$ref": "common.schema.json#/$defs/modelRef"},
        "message": {"$ref": "#/$defs/message"}
      }
    },
    "checkpointSizeMismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code", "reason", "modelRef", "expectedBytes", "actualBytes",
        "message"
      ],
      "properties": {
        "code": {"const": "MODEL_CORRUPT"},
        "reason": {"const": "MODEL_CHECKPOINT_SIZE_MISMATCH"},
        "modelRef": {"$ref": "common.schema.json#/$defs/modelRef"},
        "expectedBytes": {"$ref": "common.schema.json#/$defs/positiveInteger"},
        "actualBytes": {"$ref": "common.schema.json#/$defs/safeInteger"},
        "message": {"$ref": "#/$defs/message"}
      }
    },
    "checkpointDigestMismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code", "reason", "modelRef", "expectedSha256", "actualSha256",
        "message"
      ],
      "properties": {
        "code": {"const": "MODEL_CORRUPT"},
        "reason": {"const": "MODEL_CHECKPOINT_DIGEST_MISMATCH"},
        "modelRef": {"$ref": "common.schema.json#/$defs/modelRef"},
        "expectedSha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "actualSha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "message": {"$ref": "#/$defs/message"}
      }
    },
    "checkpointBudgetExceeded": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code", "reason", "modelRef", "checkpointBytes", "maxBytes",
        "message"
      ],
      "properties": {
        "code": {"const": "RESOURCE_EXHAUSTED"},
        "reason": {"const": "CHECKPOINT_VERIFICATION_BUDGET_EXCEEDED"},
        "modelRef": {"$ref": "common.schema.json#/$defs/modelRef"},
        "checkpointBytes": {"$ref": "common.schema.json#/$defs/positiveInteger"},
        "maxBytes": {"const": 1073741824},
        "message": {"$ref": "#/$defs/message"}
      }
    },
    "responseBudgetExceeded": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason", "maxBytes", "message"],
      "properties": {
        "code": {"const": "RESOURCE_EXHAUSTED"},
        "reason": {"const": "CATALOG_RESPONSE_BUDGET_EXCEEDED"},
        "maxBytes": {"const": 8388608},
        "message": {"$ref": "#/$defs/message"}
      }
    },
    "registryUnavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "reason", "message"],
      "properties": {
        "code": {"const": "UNAVAILABLE"},
        "reason": {"const": "MODEL_REGISTRY_UNAVAILABLE"},
        "message": {"$ref": "#/$defs/message"}
      }
    }
  }
}
