{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/model-catalog/v1/common.schema.json",
  "title": "Transformer model catalog query v1 common definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "modelRef": {"type": "string", "pattern": "^mdl_[0-9a-f]{32}$"},
    "label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$"
    },
    "cursor": {
      "type": "string",
      "minLength": 47,
      "maxLength": 1028,
      "pattern": "^mc1\\.[A-Za-z0-9_-]{43,1024}$"
    },
    "semanticDigests": {
      "$ref": "https://transformer.local/contracts/semantic/v1/semantic-digests.schema.json"
    },
    "modelConfig": {
      "$ref": "https://transformer.local/contracts/semantic/v1/common.schema.json#/$defs/modelConfig"
    },
    "checkpointSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "sha256", "bytes"],
      "properties": {
        "format": {"const": "transformer-checkpoint-v6"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "initializationSummary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {"kind": {"const": "random"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "parentModelRef"],
          "properties": {
            "kind": {"const": "publishedModel"},
            "parentModelRef": {"$ref": "#/$defs/modelRef"}
          }
        }
      ]
    },
    "targetIdentities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identity"}
    },
    "modelSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelRef", "label", "generation", "createdAt", "semanticDigests",
        "modelConfig", "targetIdentities", "initialization",
        "producingRunId", "checkpoint"
      ],
      "properties": {
        "modelRef": {"$ref": "#/$defs/modelRef"},
        "label": {"$ref": "#/$defs/label"},
        "generation": {"$ref": "#/$defs/positiveInteger"},
        "createdAt": {"$ref": "#/$defs/timestamp"},
        "semanticDigests": {"$ref": "#/$defs/semanticDigests"},
        "modelConfig": {"$ref": "#/$defs/modelConfig"},
        "targetIdentities": {"$ref": "#/$defs/targetIdentities"},
        "initialization": {"$ref": "#/$defs/initializationSummary"},
        "producingRunId": {"$ref": "#/$defs/uuid"},
        "checkpoint": {"$ref": "#/$defs/checkpointSummary"}
      }
    },
    "selectionSummary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled", "modelContractSha256", "bestSelectionScore",
            "bestEpoch", "source"
          ],
          "properties": {
            "enabled": {"const": false},
            "modelContractSha256": {"$ref": "#/$defs/sha256"},
            "bestSelectionScore": {"type": "null"},
            "bestEpoch": {"type": "null"},
            "source": {"const": "last_epoch"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled", "modelContractSha256", "bestSelectionScore",
            "bestEpoch", "source"
          ],
          "properties": {
            "enabled": {"const": true},
            "modelContractSha256": {"$ref": "#/$defs/sha256"},
            "bestSelectionScore": {"type": "number"},
            "bestEpoch": {"$ref": "#/$defs/positiveInteger"},
            "source": {"const": "best_direct_selection_score"}
          }
        }
      ]
    },
    "terminalProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completedEpochs", "globalStep", "trainingComplete"],
      "properties": {
        "completedEpochs": {"$ref": "#/$defs/positiveInteger"},
        "globalStep": {"$ref": "#/$defs/positiveInteger"},
        "trainingComplete": {"const": true}
      }
    },
    "modelDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary", "dataContract", "modelContract", "trainingConfig",
        "diagnostics", "selection", "progress", "initialization",
        "jobConfigSha256"
      ],
      "properties": {
        "summary": {"$ref": "#/$defs/modelSummary"},
        "dataContract": {
          "$ref": "https://transformer.local/contracts/semantic/v1/common.schema.json#/$defs/dataContract"
        },
        "modelContract": {
          "$ref": "https://transformer.local/contracts/semantic/model-contract-envelope.schema.json"
        },
        "trainingConfig": {
          "$ref": "https://transformer.local/contracts/checkpoint/v6/common.schema.json#/$defs/trainingConfig"
        },
        "diagnostics": {
          "$ref": "https://transformer.local/contracts/checkpoint/v6/common.schema.json#/$defs/diagnosticsConfig"
        },
        "selection": {"$ref": "#/$defs/selectionSummary"},
        "progress": {"$ref": "#/$defs/terminalProgress"},
        "initialization": {
          "$ref": "https://transformer.local/contracts/semantic/v1/common.schema.json#/$defs/resolvedInitialization"
        },
        "jobConfigSha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
