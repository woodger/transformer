{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/model-catalog/v1/list-result.schema.json",
  "title": "transformer.model-catalog.v1.list result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract", "revision", "requestId", "models", "nextCursor",
    "cursorExpiresAt"
  ],
  "properties": {
    "contract": {"const": "transformer-model-catalog"},
    "revision": {"const": 1},
    "requestId": {"$ref": "common.schema.json#/$defs/uuid"},
    "models": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "common.schema.json#/$defs/modelSummary"}
    },
    "nextCursor": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/cursor"}
      ]
    },
    "cursorExpiresAt": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "common.schema.json#/$defs/timestamp"}
      ]
    }
  },
  "oneOf": [
    {
      "properties": {
        "nextCursor": {"type": "null"},
        "cursorExpiresAt": {"type": "null"}
      }
    },
    {
      "properties": {
        "nextCursor": {"$ref": "common.schema.json#/$defs/cursor"},
        "cursorExpiresAt": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    }
  ]
}
