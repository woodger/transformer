{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/model-catalog/v9/common.schema.json",
  "title": "Transformer model catalog query v9 common definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "safeInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "modelRef": {
      "type": "string",
      "pattern": "^mdl_[0-9a-f]{32}$"
    },
    "label": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "identity": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "cursor": {
      "type": "string",
      "minLength": 47,
      "maxLength": 1028,
      "pattern": "^mc7\\.[A-Za-z0-9_-]{43,1024}$"
    },
    "targetIdentities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identity"
      }
    },
    "tensorGeometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seqLen",
        "featureDim"
      ],
      "properties": {
        "seqLen": {
          "$ref": "#/$defs/positiveInteger"
        },
        "featureDim": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "dataDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataContractSha256",
        "tensorGeometry"
      ],
      "properties": {
        "dataContractSha256": {
          "$ref": "#/$defs/sha256"
        },
        "tensorGeometry": {
          "$ref": "#/$defs/tensorGeometry"
        }
      }
    },
    "modelTuning": {
      "$ref": "https://transformer.local/contracts/semantic/v7/common.schema.json#/$defs/modelTuning"
    },
    "semanticDigests": {
      "$ref": "https://transformer.local/contracts/semantic/v7/semantic-digests.schema.json"
    },
    "catalogInitializationSummary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source"
          ],
          "properties": {
            "source": {
              "const": "random"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "parentModelRef"
          ],
          "properties": {
            "source": {
              "const": "publishedModel"
            },
            "parentModelRef": {
              "$ref": "#/$defs/modelRef"
            }
          }
        }
      ]
    },
    "modelSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelRef",
        "label",
        "generation",
        "createdAt",
        "dataContractSha256",
        "modelDefinitionSha256",
        "modelTuning",
        "targetIdentities",
        "initialization",
        "producingRunId"
      ],
      "properties": {
        "modelRef": {
          "$ref": "#/$defs/modelRef"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "generation": {
          "$ref": "#/$defs/positiveInteger"
        },
        "createdAt": {
          "$ref": "#/$defs/timestamp"
        },
        "dataContractSha256": {
          "$ref": "#/$defs/sha256"
        },
        "modelDefinitionSha256": {
          "$ref": "#/$defs/sha256"
        },
        "modelTuning": {
          "$ref": "#/$defs/modelTuning"
        },
        "targetIdentities": {
          "$ref": "#/$defs/targetIdentities"
        },
        "initialization": {
          "$ref": "#/$defs/catalogInitializationSummary"
        },
        "producingRunId": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "selectionSummary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "bestSelectionScore",
            "bestEpoch",
            "source"
          ],
          "properties": {
            "enabled": {
              "const": false
            },
            "bestSelectionScore": {
              "type": "null"
            },
            "bestEpoch": {
              "type": "null"
            },
            "source": {
              "const": "last_epoch"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "bestSelectionScore",
            "bestEpoch",
            "source"
          ],
          "properties": {
            "enabled": {
              "const": true
            },
            "bestSelectionScore": {
              "type": "number"
            },
            "bestEpoch": {
              "$ref": "#/$defs/positiveInteger"
            },
            "source": {
              "const": "best_direct_selection_score"
            }
          }
        }
      ]
    },
    "terminalProgress": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completedEpochs",
        "globalStep",
        "trainingComplete"
      ],
      "properties": {
        "completedEpochs": {
          "$ref": "#/$defs/positiveInteger"
        },
        "globalStep": {
          "$ref": "#/$defs/positiveInteger"
        },
        "trainingComplete": {
          "const": true
        }
      }
    },
    "modelDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "dataDefinition",
        "modelContract",
        "predictionDefinition",
        "semanticDigests",
        "trainingConfig",
        "diagnostics",
        "selection",
        "progress",
        "initialization"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/modelSummary"
        },
        "dataDefinition": {
          "$ref": "#/$defs/dataDefinition"
        },
        "modelContract": {
          "$ref": "https://transformer.local/contracts/semantic/v7/model-contract-envelope.schema.json"
        },
        "predictionDefinition": {
          "$ref": "https://transformer.local/contracts/semantic/v7/prediction-definition.schema.json"
        },
        "semanticDigests": {
          "$ref": "#/$defs/semanticDigests"
        },
        "trainingConfig": {
          "$ref": "https://transformer.local/contracts/checkpoint/v14/common.schema.json#/$defs/trainingConfig"
        },
        "diagnostics": {
          "$ref": "https://transformer.local/contracts/checkpoint/v14/common.schema.json#/$defs/diagnosticsConfig"
        },
        "selection": {
          "$ref": "#/$defs/selectionSummary"
        },
        "progress": {
          "$ref": "#/$defs/terminalProgress"
        },
        "initialization": {
          "$ref": "#/$defs/catalogInitializationSummary"
        }
      }
    }
  }
}
