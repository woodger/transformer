{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/model-catalog/v2/detail-request.schema.json",
  "title": "transformer.model-catalog.v2.detail request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "revision",
    "requestId",
    "modelRef"
  ],
  "properties": {
    "contract": {
      "const": "transformer-model-catalog"
    },
    "revision": {
      "const": 2
    },
    "requestId": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "modelRef": {
      "$ref": "common.schema.json#/$defs/modelRef"
    }
  }
}
