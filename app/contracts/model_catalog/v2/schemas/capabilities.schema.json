{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/model-catalog/v2/capabilities.schema.json",
  "title": "Transformer model catalog query v2 capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "revision",
    "operations",
    "transport",
    "consistency",
    "limits",
    "features"
  ],
  "properties": {
    "contract": {
      "const": "transformer-model-catalog"
    },
    "revision": {
      "const": 2
    },
    "operations": {
      "const": [
        "detail",
        "list"
      ]
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "actions"
      ],
      "properties": {
        "actions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "detail",
            "list"
          ],
          "properties": {
            "detail": {
              "const": "transformer.model-catalog.v2.detail"
            },
            "list": {
              "const": "transformer.model-catalog.v2.list"
            }
          }
        },
        "protocol": {
          "const": "ArrowFlightDoAction"
        }
      }
    },
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consistencyModel",
        "ordering",
        "concurrentPublication",
        "concurrentDeletion",
        "cursorExpiration"
      ],
      "properties": {
        "ordering": {
          "const": [
            {
              "field": "createdAt",
              "direction": "DESC"
            },
            {
              "field": "modelRef",
              "direction": "ASC"
            }
          ]
        },
        "concurrentPublication": {
          "const": "ExcludedAfterHighWater"
        },
        "concurrentDeletion": {
          "const": "MayOmit"
        },
        "cursorExpiration": {
          "const": "RestartTraversal"
        },
        "consistencyModel": {
          "const": "LiveHighWater"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxPageSize",
        "cursorTtlSeconds",
        "maxResponseBytes",
        "maxCheckpointVerificationsPerDetail",
        "maxCheckpointVerificationBytes"
      ],
      "properties": {
        "maxPageSize": {
          "const": 100
        },
        "cursorTtlSeconds": {
          "const": 900
        },
        "maxResponseBytes": {
          "const": 8388608
        },
        "maxCheckpointVerificationsPerDetail": {
          "const": 1
        },
        "maxCheckpointVerificationBytes": {
          "const": 1073741824
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ownerScope",
        "filters",
        "batchDetail",
        "serverSideComparison",
        "checkpointVerification",
        "structuredErrors"
      ],
      "properties": {
        "ownerScope": {
          "const": "AuthenticatedSubject"
        },
        "filters": {
          "const": false
        },
        "batchDetail": {
          "const": false
        },
        "serverSideComparison": {
          "const": false
        },
        "checkpointVerification": {
          "const": "FullSha256"
        },
        "structuredErrors": {
          "const": true
        }
      }
    }
  }
}
