{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/checkpoint/v6/checkpoint-metadata.schema.json",
  "title": "Transformer checkpoint v6 embedded metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "serviceVersion", "generation", "jobId", "dataContract", "modelContract", "semanticDigests", "trainingConfig", "diagnostics", "selection", "initialization", "jobConfigSha256", "manifestSha256", "progress"],
  "properties": {
    "format": {"const": "transformer-checkpoint-v6"},
    "serviceVersion": {"type": "string", "minLength": 1, "maxLength": 64},
    "generation": {"type": "integer", "minimum": 1},
    "jobId": {"$ref": "common.schema.json#/$defs/uuid"},
    "dataContract": {"$ref": "https://transformer.local/contracts/semantic/v1/common.schema.json#/$defs/dataContract"},
    "modelContract": {"$ref": "https://transformer.local/contracts/semantic/model-contract-envelope.schema.json"},
    "semanticDigests": {"$ref": "https://transformer.local/contracts/semantic/v1/semantic-digests.schema.json"},
    "trainingConfig": {"$ref": "common.schema.json#/$defs/trainingConfig"},
    "diagnostics": {"$ref": "common.schema.json#/$defs/diagnosticsConfig"},
    "selection": {"$ref": "common.schema.json#/$defs/selectionState"},
    "initialization": {"$ref": "common.schema.json#/$defs/resolvedInitialization"},
    "jobConfigSha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "manifestSha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "progress": {"$ref": "common.schema.json#/$defs/progress"}
  }
}
