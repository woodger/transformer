{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/model-topology/v2/fixture-manifest.schema.json",
  "title": "Transformer model topology v2 fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "revision", "files"],
  "properties": {
    "contract": {"const": "transformer-model-topology"},
    "revision": {"const": 2},
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "common.schema.json#/$defs/sha256"}
        }
      }
    }
  }
}
