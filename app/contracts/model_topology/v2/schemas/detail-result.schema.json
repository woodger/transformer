{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/model-topology/v2/detail-result.schema.json",
  "title": "transformer.model-topology.v2.detail result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "modelRef",
    "modelDefinitionSha256",
    "topologyRevision",
    "nodes",
    "edges"
  ],
  "properties": {
    "requestId": {"$ref": "common.schema.json#/$defs/uuid"},
    "modelRef": {"$ref": "common.schema.json#/$defs/modelRef"},
    "modelDefinitionSha256": {"$ref": "common.schema.json#/$defs/sha256"},
    "topologyRevision": {"const": 2},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"$ref": "common.schema.json#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "common.schema.json#/$defs/edge"}
    }
  }
}
