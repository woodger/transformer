# Подключение к PostgreSQL для команд, которым требуется ресурс `db`.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transformer

# Временное хранилище входных payload, результатов и состояния выполняемых
# заданий. Потеря этой директории инвалидирует связанные задания.
TRANSFORMER_RUNTIME_DIR=/tmp/transformer

# Адрес и порт, на которых сервер Arrow Flight принимает подключения.
TRANSFORMER_HOST=127.0.0.1
TRANSFORMER_PORT=8815

# Разрешение соединений без TLS. Используйте только для loopback или внутри
# доверенной локальной сети.
TRANSFORMER_ALLOW_PLAINTEXT=true

# TLS или mTLS. Для TLS нужны certificate и key, а для mTLS дополнительно
# требуются client CA и проверка клиентского сертификата.
# TRANSFORMER_ALLOW_PLAINTEXT=false
# TRANSFORMER_TLS_CERT_FILE=/path/to/server.crt
# TRANSFORMER_TLS_KEY_FILE=/path/to/server.key
# TRANSFORMER_TLS_CA_FILE=/path/to/client-ca.crt
# TRANSFORMER_TLS_REQUIRE_CLIENT_CERT=true

# Количество одновременно выполняемых заданий на CPU и CUDA. Контракт v1
# поддерживает ровно одну FIFO-очередь CUDA.
TRANSFORMER_CPU_CAPACITY=2
TRANSFORMER_CUDA_CAPACITY=1

# Минимальный свободный объём runtime-хранилища в байтах. При меньшем объёме
# сервер перестаёт принимать новые payload.
TRANSFORMER_DISK_MIN_FREE_BYTES=1073741824

# Срок хранения завершённых заданий в секундах.
TRANSFORMER_RETENTION_SECONDS=604800
