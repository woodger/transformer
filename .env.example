# Copy this file to .env and replace the placeholder values.
# Do not commit the resulting .env file.

POSTGRES_HOST=replace-with-database-host
POSTGRES_PORT=5432
POSTGRES_DB=replace-with-database-name
POSTGRES_USER=replace-with-database-user
POSTGRES_PASSWORD=replace-with-database-password

TRANSFORMER_RUNTIME_DIR=/tmp/transformer
TRANSFORMER_HOST=127.0.0.1
TRANSFORMER_PORT=8815

# Loopback plaintext example. For a remote Inventory host, bind the exact LAN
# address and either keep explicit plaintext on a trusted network or configure
# the TLS settings below.
TRANSFORMER_ALLOW_PLAINTEXT=true

# TLS and mTLS alternatives:
# TRANSFORMER_ALLOW_PLAINTEXT=false
# TRANSFORMER_TLS_CERT_FILE=/path/to/server.crt
# TRANSFORMER_TLS_KEY_FILE=/path/to/server.key
# TRANSFORMER_TLS_CA_FILE=/path/to/client-ca.crt
# TRANSFORMER_TLS_REQUIRE_CLIENT_CERT=true

TRANSFORMER_CPU_CAPACITY=2
TRANSFORMER_CUDA_CAPACITY=1
TRANSFORMER_DISK_MIN_FREE_BYTES=1073741824
TRANSFORMER_RETENTION_SECONDS=604800
