{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v1/common.schema.json",
  "title": "Transformer Flight v1 common envelope",
  "type": "object",
  "required": ["contract", "version", "requestId"],
  "properties": {
    "contract": {"const": "transformer-flight"},
    "version": {"const": 1},
    "requestId": {"type": "string", "format": "uuid"},
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    }
  }
}
