{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v1/capabilities-result.schema.json",
  "title": "transformer.v1.capabilities result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "requestId",
    "protocolVersions",
    "service",
    "schemaIds",
    "limits",
    "devices",
    "queue",
    "supportedOperations",
    "features"
  ],
  "properties": {
    "contract": {"const": "transformer-flight"},
    "version": {"const": 1},
    "requestId": {"type": "string", "format": "uuid"},
    "protocolVersions": {
      "type": "array",
      "prefixItems": [{"const": 1}],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "pyarrowVersion", "torchVersion"],
      "properties": {
        "name": {"const": "transformer-flight"},
        "version": {"type": "string", "minLength": 1},
        "pyarrowVersion": {"type": "string", "minLength": 1},
        "torchVersion": {"type": "string", "minLength": 1}
      }
    },
    "schemaIds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fitInput", "predictInput", "predictionOutput"],
      "properties": {
        "fitInput": {"const": "inventory.sequence.fit.v1"},
        "predictInput": {"const": "inventory.sequence.predict.v1"},
        "predictionOutput": {"const": "transformer.prediction.v1"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxMessageBytes",
        "targetBatchBytes",
        "maxBatchBytes",
        "maxPayloadBytes",
        "maxRowsPerPayload",
        "maxPayloadsPerJob",
        "maxJobBytes",
        "maxActiveJobsPerSubject",
        "transportMessageLimitEnforced"
      ],
      "properties": {
        "maxMessageBytes": {"type": "integer", "minimum": 1},
        "targetBatchBytes": {"type": "integer", "minimum": 1},
        "maxBatchBytes": {"type": "integer", "minimum": 1},
        "maxPayloadBytes": {"type": "integer", "minimum": 1},
        "maxRowsPerPayload": {"type": "integer", "minimum": 1},
        "maxPayloadsPerJob": {"type": "integer", "minimum": 1, "maximum": 400},
        "maxJobBytes": {"type": "integer", "minimum": 1},
        "maxActiveJobsPerSubject": {"type": "integer", "minimum": 1},
        "transportMessageLimitEnforced": {"const": false}
      }
    },
    "devices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "cuda"],
      "properties": {
        "cpu": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available"],
          "properties": {"available": {"const": true}}
        },
        "cuda": {
          "type": "object",
          "additionalProperties": false,
          "required": ["available", "deviceCount", "runtimeVersion"],
          "properties": {
            "available": {"type": "boolean"},
            "deviceCount": {"type": "integer", "minimum": 0},
            "runtimeVersion": {"type": ["string", "null"]}
          },
          "allOf": [
            {
              "if": {
                "properties": {"available": {"const": false}},
                "required": ["available"]
              },
              "then": {
                "properties": {
                  "deviceCount": {"const": 0}
                }
              },
              "else": {
                "properties": {
                  "deviceCount": {"type": "integer", "minimum": 1},
                  "runtimeVersion": {"type": "string", "minLength": 1}
                }
              }
            }
          ]
        }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpuCapacity", "cudaCapacity", "singleInstance"],
      "properties": {
        "cpuCapacity": {"type": "integer", "minimum": 1},
        "cudaCapacity": {"const": 1},
        "singleInstance": {"const": true}
      }
    },
    "supportedOperations": {
      "type": "array",
      "prefixItems": [{"const": "fit"}, {"const": "predict"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doExchange", "pollFlightInfo"],
      "properties": {
        "doExchange": {"const": false},
        "pollFlightInfo": {"const": false}
      }
    }
  }
}
