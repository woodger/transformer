{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v1/seal.schema.json",
  "title": "transformer.v1.job.seal request",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract", "version", "requestId", "idempotencyKey", "jobId", "manifest"],
  "properties": {
    "contract": {"const": "transformer-flight"},
    "version": {"const": 1},
    "requestId": {"type": "string", "format": "uuid"},
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "jobId": {"type": "string", "format": "uuid"},
    "manifest": {
      "type": "array",
      "maxItems": 400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["payloadId", "ordinal", "sha256"],
        "properties": {
          "payloadId": {"type": "string", "format": "uuid"},
          "ordinal": {"type": "integer", "minimum": 0, "maximum": 399},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
