{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v1/health-result.schema.json",
  "title": "transformer.v1.health result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "requestId",
    "live",
    "ready",
    "draining",
    "ledger",
    "cuda",
    "disk",
    "metrics"
  ],
  "properties": {
    "contract": {"const": "transformer-flight"},
    "version": {"const": 1},
    "requestId": {"type": "string", "format": "uuid"},
    "live": {"const": true},
    "ready": {"type": "boolean"},
    "draining": {"type": "boolean"},
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": {"available": {"type": "boolean"}}
    },
    "cuda": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": {"available": {"type": "boolean"}}
    },
    "disk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["freeBytes", "watermarkBytes", "watermarkExceeded"],
      "properties": {
        "freeBytes": {"type": "integer", "minimum": 0},
        "watermarkBytes": {"type": "integer", "minimum": 1},
        "watermarkExceeded": {"type": "boolean"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rpc", "counters", "gauges"],
      "properties": {
        "rpc": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "counters": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0}
        },
        "gauges": {
          "type": "object",
          "additionalProperties": {"type": ["number", "boolean"]}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"ready": {"const": true}},
        "required": ["ready"]
      },
      "then": {
        "properties": {
          "draining": {"const": false},
          "ledger": {
            "properties": {"available": {"const": true}}
          },
          "disk": {
            "properties": {"watermarkExceeded": {"const": false}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"draining": {"const": true}},
        "required": ["draining"]
      },
      "then": {"properties": {"ready": {"const": false}}}
    },
    {
      "if": {
        "properties": {
          "ledger": {
            "properties": {"available": {"const": false}},
            "required": ["available"]
          }
        },
        "required": ["ledger"]
      },
      "then": {"properties": {"ready": {"const": false}}}
    },
    {
      "if": {
        "properties": {
          "disk": {
            "properties": {"watermarkExceeded": {"const": true}},
            "required": ["watermarkExceeded"]
          }
        },
        "required": ["disk"]
      },
      "then": {"properties": {"ready": {"const": false}}}
    }
  ]
}
