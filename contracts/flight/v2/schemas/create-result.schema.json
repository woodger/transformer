{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v2/create-result.schema.json",
  "title": "transformer.v2.job.create result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "requestId",
    "jobId",
    "operation",
    "state",
    "revision",
    "device",
    "resolvedModelRef",
    "limits",
    "upload"
  ],
  "properties": {
    "contract": {"const": "transformer-flight"},
    "version": {"const": 2},
    "requestId": {"type": "string", "format": "uuid"},
    "jobId": {"type": "string", "format": "uuid"},
    "operation": {"enum": ["fit", "predict"]},
    "state": {"const": "UPLOADING"},
    "revision": {"const": 1},
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "selected"],
      "properties": {
        "requested": {"enum": ["cpu", "cuda", "auto"]},
        "selected": {"const": null}
      }
    },
    "resolvedModelRef": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxMessageBytes",
        "targetBatchBytes",
        "maxBatchBytes",
        "maxPayloadBytes",
        "maxRowsPerPayload",
        "maxPayloadsPerJob",
        "maxJobBytes",
        "maxActiveJobsPerSubject",
        "transportMessageLimitEnforced"
      ],
      "properties": {
        "maxMessageBytes": {"type": "integer", "minimum": 1},
        "targetBatchBytes": {"type": "integer", "minimum": 1},
        "maxBatchBytes": {"type": "integer", "minimum": 1},
        "maxPayloadBytes": {"type": "integer", "minimum": 1},
        "maxRowsPerPayload": {"type": "integer", "minimum": 1},
        "maxPayloadsPerJob": {"type": "integer", "minimum": 1, "maximum": 400},
        "maxJobBytes": {"type": "integer", "minimum": 1},
        "maxActiveJobsPerSubject": {"type": "integer", "minimum": 1},
        "transportMessageLimitEnforced": {"const": false}
      }
    },
    "upload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptorPath", "schemaId", "oneDoPutIsOneSemanticFrame"],
      "properties": {
        "descriptorPath": {
          "type": "array",
          "prefixItems": [
            {"const": "transformer"},
            {"const": "v2"},
            {"const": "jobs"},
            {"type": "string", "format": "uuid"},
            {"const": "inputs"},
            {"const": "{ordinal}"}
          ],
          "items": false,
          "minItems": 6,
          "maxItems": 6
        },
        "schemaId": {
          "enum": ["inventory.sequence.fit.v1", "inventory.sequence.predict.v1"]
        },
        "oneDoPutIsOneSemanticFrame": {"const": true}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"operation": {"const": "fit"}},
        "required": ["operation"]
      },
      "then": {
        "properties": {
          "resolvedModelRef": {"const": null},
          "upload": {
            "properties": {
              "schemaId": {"const": "inventory.sequence.fit.v1"}
            }
          }
        }
      },
      "else": {
        "properties": {
          "resolvedModelRef": {"type": "string", "minLength": 1},
          "upload": {
            "properties": {
              "schemaId": {"const": "inventory.sequence.predict.v1"}
            }
          }
        }
      }
    }
  ]
}
