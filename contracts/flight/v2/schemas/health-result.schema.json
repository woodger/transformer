{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transformer.local/contracts/flight/v2/health-result.schema.json",
  "title": "transformer.v2.health result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "requestId",
    "live",
    "ready",
    "draining",
    "ledger",
    "cuda",
    "storage",
    "metrics"
  ],
  "properties": {
    "contract": {"const": "transformer-flight"},
    "version": {"const": 2},
    "requestId": {"type": "string", "format": "uuid"},
    "live": {"const": true},
    "ready": {"type": "boolean"},
    "draining": {"type": "boolean"},
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available"],
      "properties": {"available": {"type": "boolean"}}
    },
    "cuda": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "deviceCount", "quarantinedCount"],
      "properties": {
        "available": {"type": "boolean"},
        "deviceCount": {"type": "integer", "minimum": 0},
        "quarantinedCount": {"type": "integer", "minimum": 0}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "recovery"],
      "properties": {
        "runtime": {"$ref": "#/$defs/storageHealth"},
        "recovery": {"$ref": "#/$defs/storageHealth"}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rpc", "counters", "gauges"],
      "properties": {
        "rpc": {
          "type": "object",
          "additionalProperties": {"type": "integer", "minimum": 0}
        },
        "counters": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0}
        },
        "gauges": {
          "type": "object",
          "additionalProperties": {"type": ["number", "boolean"]}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"ready": {"const": true}},
        "required": ["ready"]
      },
      "then": {
        "properties": {
          "draining": {"const": false},
          "ledger": {
            "properties": {"available": {"const": true}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {"draining": {"const": true}},
        "required": ["draining"]
      },
      "then": {"properties": {"ready": {"const": false}}}
    },
    {
      "if": {
        "properties": {
          "ledger": {
            "properties": {"available": {"const": false}},
            "required": ["available"]
          }
        },
        "required": ["ledger"]
      },
      "then": {"properties": {"ready": {"const": false}}}
    }
  ],
  "$defs": {
    "storageHealth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "freeBytes"
      ],
      "properties": {
        "freeBytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
